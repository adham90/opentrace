package errorviews

import (
	"fmt"
	"github.com/adham90/opentrace/components/badge"
	"github.com/adham90/opentrace/components/button"
	"github.com/adham90/opentrace/components/card"
	"github.com/adham90/opentrace/components/table"
	"github.com/adham90/opentrace/internal/store"
	"github.com/adham90/opentrace/internal/views"
)

templ ErrorDetailPage(data views.LayoutData, errorGroup store.ErrorGroup, errorLogs []store.LogEntry) {
	@views.Layout(data) {
		<div class="space-y-6">
			<!-- Header -->
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-bold tracking-tight">
					Error
					<span class="text-muted-foreground font-normal ml-1">{ errorGroup.ExceptionClass }</span>
				</h1>
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Href:    "/errors",
					Size:    button.SizeSm,
				}) {
					Back to errors
				}
			</div>
			<!-- Summary -->
			@card.Card() {
				@card.Content(card.ContentProps{Class: "p-4"}) {
					<div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
						<div class="flex items-center gap-1.5">
							<span class="text-muted-foreground">status:</span>
							@errorStatusBadge(string(errorGroup.Status))
						</div>
						<div class="flex items-center gap-1.5">
							<span class="text-muted-foreground">occurrences:</span>
							<strong>{ fmt.Sprintf("%d", errorGroup.OccurrenceCount) }</strong>
						</div>
						if errorGroup.Service != "" {
							<div class="flex items-center gap-1.5">
								<span class="text-muted-foreground">service:</span>
								@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
									{ errorGroup.Service }
								}
							</div>
						}
						if errorGroup.Environment != "" {
							<div class="flex items-center gap-1.5">
								<span class="text-muted-foreground">env:</span>
								@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
									{ errorGroup.Environment }
								}
							</div>
						}
						if errorGroup.UniqueUsers > 0 {
							<div class="flex items-center gap-1.5">
								<span class="text-muted-foreground">users affected:</span>
								<strong>{ fmt.Sprintf("%d", errorGroup.UniqueUsers) }</strong>
							</div>
						}
						if errorGroup.ReopenedCount > 0 {
							<div class="flex items-center gap-1.5">
								<span class="text-muted-foreground">reopened:</span>
								<strong>{ fmt.Sprintf("%dx", errorGroup.ReopenedCount) }</strong>
							</div>
						}
						<div class="flex items-center gap-1.5">
							<span class="text-muted-foreground">first seen:</span>
							<span>{ views.TimeAgo(errorGroup.FirstSeenAt) }</span>
						</div>
						<div class="flex items-center gap-1.5">
							<span class="text-muted-foreground">last seen:</span>
							<span>{ views.TimeAgo(errorGroup.LastSeenAt) }</span>
						</div>
						if errorGroup.SourceFile != "" {
							<div class="flex items-center gap-1.5">
								<span class="text-muted-foreground">source:</span>
								<code class="text-xs">
									{ errorGroup.SourceFile }
									if errorGroup.SourceLine > 0 {
										{ fmt.Sprintf(":%d", errorGroup.SourceLine) }
									}
								</code>
							</div>
						}
						<div class="flex items-center gap-1.5">
							<span class="text-muted-foreground">fingerprint:</span>
							<code class="text-xs text-muted-foreground">{ errorGroup.Fingerprint }</code>
						</div>
					</div>
				}
			}
			<!-- Histogram -->
			@card.Card() {
				@card.Content(card.ContentProps{Class: "p-4"}) {
					<div class="flex items-center justify-between mb-2">
						<span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Occurrence Timeline</span>
						<div class="flex gap-0.5" id="ed-time-range">
							<button data-range="1h" class="px-2.5 py-1 text-xs border rounded-l-md cursor-pointer bg-background text-muted-foreground hover:bg-accent">1h</button>
							<button data-range="6h" class="px-2.5 py-1 text-xs border-y border-r cursor-pointer bg-background text-muted-foreground hover:bg-accent">6h</button>
							<button data-range="24h" class="px-2.5 py-1 text-xs border-y border-r cursor-pointer bg-background text-muted-foreground hover:bg-accent">24h</button>
							<button data-range="7d" class="px-2.5 py-1 text-xs border-y border-r rounded-r-md cursor-pointer bg-primary text-primary-foreground">7d</button>
						</div>
					</div>
					<div class="h-20 border rounded-md bg-muted/30 relative overflow-hidden cursor-crosshair" id="ed-histogram-container">
						<svg id="ed-histogram-svg" width="100%" height="100%" preserveAspectRatio="none"></svg>
						<div class="absolute hidden bg-popover border rounded px-2 py-1 text-xs font-mono pointer-events-none z-20 whitespace-nowrap" id="ed-histogram-tooltip"></div>
					</div>
				}
			}
			<!-- Error Message -->
			@card.Card() {
				@card.Content(card.ContentProps{Class: "p-4"}) {
					<pre class="text-sm font-mono whitespace-pre-wrap break-words text-foreground">{ errorGroup.Message }</pre>
				}
			}
			<!-- Actions -->
			<div class="flex gap-2" id="error-actions">
				if string(errorGroup.Status) == "unresolved" {
					@button.Button(button.Props{
						ID:      "btn-resolve",
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Class:   "border-green-500 text-green-500 hover:bg-green-500/10",
					}) {
						Resolve
					}
					@button.Button(button.Props{
						ID:      "btn-ignore",
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
					}) {
						Ignore
					}
				}
				@button.Button(button.Props{
					ID:      "btn-view-logs",
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "border-blue-500 text-blue-500 hover:bg-blue-500/10",
				}) {
					View in logs
				}
			</div>
			<!-- Recent Occurrences -->
			if len(errorLogs) > 0 {
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Recent Occurrences
							<span class="text-muted-foreground font-normal text-sm ml-1">({ fmt.Sprintf("%d", len(errorLogs)) })</span>
						}
					}
					@card.Content(card.ContentProps{Class: "p-0"}) {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										Time
									}
									@table.Head() {
										Level
									}
									@table.Head() {
										Service
									}
									@table.Head() {
										Message
									}
									@table.Head() {
										Trace
									}
								}
							}
							@table.Body() {
								for _, log := range errorLogs {
									@table.Row(table.RowProps{Class: "cursor-pointer"}) {
										@table.Cell(table.CellProps{Class: "whitespace-nowrap text-muted-foreground text-xs"}) {
											{ log.Timestamp.Format("Jan 02 15:04:05") }
										}
										@table.Cell() {
											<span class={ "text-xs font-medium",
												templ.KV("text-red-500", log.Level == "ERROR" || log.Level == "FATAL"),
												templ.KV("text-yellow-500", log.Level == "WARN"),
											}>
												{ log.Level }
											</span>
										}
										@table.Cell() {
											if log.Service != "" {
												@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
													{ log.Service }
												}
											}
										}
										@table.Cell(table.CellProps{Class: "max-w-[400px] truncate text-xs"}) {
											{ truncateStr(log.Message, 100) }
										}
										@table.Cell() {
											if log.TraceID != "" {
												<a
													href={ templ.SafeURL("/logs?trace_id=" + log.TraceID) }
													class="text-xs text-primary hover:underline"
												>
													{ truncateStr(log.TraceID, 12) }
												</a>
											}
										}
									}
								}
							}
						}
					}
				}
			} else {
				@card.Card() {
					@card.Content(card.ContentProps{Class: "py-8 text-center"}) {
						<p class="text-sm text-muted-foreground">No log entries found for this error fingerprint.</p>
					}
				}
			}
			<!-- Timeline Events -->
			if len(errorGroup.Events) > 0 {
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Timeline
						}
					}
					@card.Content(card.ContentProps{Class: "p-0"}) {
						<ul class="divide-y divide-border">
							for _, ev := range errorGroup.Events {
								<li class="px-4 py-3 flex items-center gap-2 text-sm">
									<span class="font-semibold uppercase text-xs">{ ev.Action }</span>
									if ev.Reason != "" {
										<span>{ ev.Reason }</span>
									}
									<span class="text-muted-foreground text-xs ml-auto">{ views.TimeAgo(ev.CreatedAt) }</span>
								</li>
							}
						</ul>
					}
				}
			}
		</div>
		@errorDetailScript(errorGroup.Fingerprint)
	}
}

templ errorStatusBadge(status string) {
	if status == "unresolved" {
		@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
			{ status }
		}
	} else if status == "resolved" {
		@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "bg-green-500/15 text-green-600 border-green-500/30"}) {
			{ status }
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
			{ status }
		}
	}
}

templ errorDetailScript(fingerprint string) {
	<script>
		(function() {
			var fp = { templ.JSONString(fingerprint) };
			var histSvg = document.getElementById('ed-histogram-svg');
			var histTooltip = document.getElementById('ed-histogram-tooltip');
			var histContainer = document.getElementById('ed-histogram-container');
			var currentRange = '7d';
			var lastBuckets = [];

			function fetchHistogram(range) {
				currentRange = range;
				var buttons = document.querySelectorAll('#ed-time-range button');
				for (var i = 0; i < buttons.length; i++) {
					var isActive = buttons[i].getAttribute('data-range') === range;
					buttons[i].className = 'px-2.5 py-1 text-xs cursor-pointer ' +
						(i === 0 ? 'border rounded-l-md ' : (i === buttons.length - 1 ? 'border-y border-r rounded-r-md ' : 'border-y border-r ')) +
						(isActive ? 'bg-primary text-primary-foreground' : 'bg-background text-muted-foreground hover:bg-accent');
				}
				fetch('/api/errors/' + encodeURIComponent(fp) + '/histogram?time_range=' + range)
					.then(function(r) { return r.json(); })
					.then(function(buckets) {
						if (!Array.isArray(buckets)) { lastBuckets = []; renderHistogram([]); return; }
						lastBuckets = buckets;
						renderHistogram(buckets);
					}).catch(function() {
						lastBuckets = [];
						histSvg.innerHTML = '<text x="50%" y="50%" text-anchor="middle" fill="currentColor" font-size="11" class="text-muted-foreground">unavailable</text>';
					});
			}

			function renderHistogram(buckets) {
				if (!buckets || buckets.length === 0) {
					histSvg.innerHTML = '<text x="50%" y="50%" text-anchor="middle" fill="currentColor" font-size="11" class="text-muted-foreground">no data</text>';
					return;
				}
				var rect = histContainer.getBoundingClientRect();
				var width = rect.width, height = rect.height;
				var barGap = 1;
				var barWidth = Math.max(2, (width - barGap * buckets.length) / buckets.length);
				var maxCount = 0;
				for (var i = 0; i < buckets.length; i++) { if (buckets[i].count > maxCount) maxCount = buckets[i].count; }
				if (maxCount === 0) {
					histSvg.innerHTML = '<text x="50%" y="50%" text-anchor="middle" fill="currentColor" font-size="11" class="text-muted-foreground">no occurrences</text>';
					return;
				}
				var svgNS = 'http://www.w3.org/2000/svg';
				while (histSvg.firstChild) histSvg.removeChild(histSvg.firstChild);
				histSvg.setAttribute('viewBox', '0 0 ' + width + ' ' + height);
				for (var i = 0; i < buckets.length; i++) {
					var b = buckets[i], x = i * (barWidth + barGap);
					var h = (b.count / maxCount) * (height - 4);
					if (b.count > 0 && h < 2) h = 2;
					var bar = document.createElementNS(svgNS, 'rect');
					bar.setAttribute('x', x); bar.setAttribute('y', height - h);
					bar.setAttribute('width', barWidth); bar.setAttribute('height', h);
					bar.setAttribute('fill', 'hsl(var(--destructive))'); bar.setAttribute('opacity', '0.6');
					bar.setAttribute('data-idx', i);
					bar.addEventListener('mouseenter', function() { this.setAttribute('opacity', '1'); });
					bar.addEventListener('mouseleave', function() { this.setAttribute('opacity', '0.6'); });
					histSvg.appendChild(bar);
				}
			}

			histContainer.addEventListener('mousemove', function(e) {
				if (!lastBuckets || lastBuckets.length === 0) return;
				var rect = histContainer.getBoundingClientRect();
				var x = e.clientX - rect.left;
				var barGap = 1;
				var barWidth = Math.max(2, (rect.width - barGap * lastBuckets.length) / lastBuckets.length);
				var idx = Math.floor(x / (barWidth + barGap));
				if (idx < 0 || idx >= lastBuckets.length) { histTooltip.style.display = 'none'; return; }
				var b = lastBuckets[idx];
				var ts = new Date(b.timestamp);
				var fmt = currentRange === '7d' || currentRange === '24h'
					? ts.toLocaleDateString(undefined, {month:'short',day:'numeric'}) + ' ' + ts.toLocaleTimeString(undefined, {hour:'2-digit',minute:'2-digit'})
					: ts.toLocaleTimeString(undefined, {hour:'2-digit',minute:'2-digit'});
				histTooltip.textContent = fmt + ' \u2014 ' + b.count + ' occurrence' + (b.count !== 1 ? 's' : '');
				histTooltip.style.display = 'block';
				var tipX = e.clientX - rect.left + 10;
				if (tipX + histTooltip.offsetWidth > rect.width) tipX = tipX - histTooltip.offsetWidth - 20;
				histTooltip.style.left = tipX + 'px'; histTooltip.style.top = '4px';
			});
			histContainer.addEventListener('mouseleave', function() { histTooltip.style.display = 'none'; });

			document.querySelectorAll('#ed-time-range button').forEach(function(btn) {
				btn.addEventListener('click', function() { fetchHistogram(this.getAttribute('data-range')); });
			});
			fetchHistogram('7d');

			// Actions
			var btnResolve = document.getElementById('btn-resolve');
			if (btnResolve) {
				btnResolve.addEventListener('click', function() {
					if (!confirm('Resolve this error group?')) return;
					fetch('/api/errors/' + encodeURIComponent(fp) + '/resolve', {
						method: 'POST', headers: {'Content-Type':'application/json'},
						body: JSON.stringify({reason:'Resolved from UI'})
					}).then(function(r) { if (r.ok) location.reload(); else r.json().then(function(d) { alert(d.error || 'Failed'); }); });
				});
			}
			var btnIgnore = document.getElementById('btn-ignore');
			if (btnIgnore) {
				btnIgnore.addEventListener('click', function() {
					if (!confirm('Ignore this error group?')) return;
					fetch('/api/errors/' + encodeURIComponent(fp) + '/ignore', {
						method: 'POST', headers: {'Content-Type':'application/json'},
						body: JSON.stringify({reason:'Ignored from UI'})
					}).then(function(r) { if (r.ok) location.reload(); else r.json().then(function(d) { alert(d.error || 'Failed'); }); });
				});
			}
			var btnLogs = document.getElementById('btn-view-logs');
			if (btnLogs) {
				btnLogs.addEventListener('click', function() {
					window.location.href = '/logs?error_fingerprint=' + encodeURIComponent(fp);
				});
			}
		})();
	</script>
}
