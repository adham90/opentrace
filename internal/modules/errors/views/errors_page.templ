package errorviews

import (
	"fmt"
	"github.com/adham90/opentrace/components/badge"
	"github.com/adham90/opentrace/components/card"
	"github.com/adham90/opentrace/components/table"
	"github.com/adham90/opentrace/internal/store"
	"github.com/adham90/opentrace/internal/views"
)

templ ErrorsPage(data views.LayoutData, errorGroups []store.ErrorGroup) {
	@views.Layout(data) {
		<div class="space-y-6">
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-bold tracking-tight">Errors</h1>
				<div>
					<select id="status-filter" class="h-9 rounded-md border border-input bg-background px-3 py-1 text-sm shadow-xs focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] outline-none cursor-pointer">
						<option value="">all statuses</option>
						<option value="unresolved">unresolved</option>
						<option value="resolved">resolved</option>
						<option value="ignored">ignored</option>
					</select>
				</div>
			</div>
			if len(errorGroups) > 0 {
				@card.Card() {
					@card.Content(card.ContentProps{Class: "p-0"}) {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head(table.HeadProps{Class: "w-3"}) {
									}
									@table.Head() {
										Exception
									}
									@table.Head() {
										Message
									}
									@table.Head() {
										Service
									}
									@table.Head(table.HeadProps{Class: "text-right"}) {
										Count
									}
									@table.Head() {
										First Seen
									}
									@table.Head() {
										Last Seen
									}
								}
							}
							@table.Body(table.BodyProps{ID: "errors-table-body"}) {
								for _, eg := range errorGroups {
									@table.Row(table.RowProps{
										Class:      "cursor-pointer",
										Attributes: templ.Attributes{"data-fingerprint": eg.Fingerprint},
									}) {
										@table.Cell() {
											@errorStatusDot(string(eg.Status))
										}
										@table.Cell(table.CellProps{Class: "font-medium"}) {
											{ eg.ExceptionClass }
										}
										@table.Cell(table.CellProps{Class: "max-w-[300px] truncate text-muted-foreground"}) {
											{ truncateStr(eg.Message, 80) }
										}
										@table.Cell() {
											if eg.Service != "" {
												@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
													{ eg.Service }
												}
											}
										}
										@table.Cell(table.CellProps{Class: "text-right font-semibold"}) {
											{ fmt.Sprintf("%d", eg.OccurrenceCount) }
										}
										@table.Cell(table.CellProps{Class: "text-muted-foreground text-xs"}) {
											{ views.TimeAgo(eg.FirstSeenAt) }
										}
										@table.Cell(table.CellProps{Class: "text-muted-foreground text-xs"}) {
											{ views.TimeAgo(eg.LastSeenAt) }
										}
									}
								}
							}
						}
					}
				}
			} else {
				@card.Card() {
					@card.Content(card.ContentProps{Class: "py-12 text-center"}) {
						<p class="text-lg font-medium text-muted-foreground">No error groups</p>
						<p class="text-sm text-muted-foreground mt-1">Error groups will appear here when errors are ingested with fingerprints.</p>
					}
				}
			}
		</div>
		@errorsScript()
	}
}

templ errorStatusDot(status string) {
	<span class={ "inline-block w-2 h-2 rounded-full",
		templ.KV("bg-red-500", status == "unresolved"),
		templ.KV("bg-green-500", status == "resolved"),
		templ.KV("bg-muted-foreground", status == "ignored"),
	}></span>
}

func truncateStr(s string, maxLen int) string {
	runes := []rune(s)
	if len(runes) <= maxLen {
		return s
	}
	return string(runes[:maxLen]) + "..."
}

templ errorsScript() {
	<script>
		(function() {
			var tbody = document.getElementById('errors-table-body');
			if (tbody) {
				tbody.addEventListener('click', function(e) {
					var row = e.target.closest('tr[data-fingerprint]');
					if (row && row.dataset.fingerprint) {
						window.location.href = '/errors/' + encodeURIComponent(row.dataset.fingerprint);
					}
				});
			}
			var filter = document.getElementById('status-filter');
			if (filter) {
				var params = new URLSearchParams(window.location.search);
				if (params.get('status')) filter.value = params.get('status');
				filter.addEventListener('change', function() {
					var url = '/errors';
					if (this.value) url += '?status=' + encodeURIComponent(this.value);
					window.location.href = url;
				});
			}
		})();
	</script>
}
