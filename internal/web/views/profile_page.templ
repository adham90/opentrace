package webviews

import (
	"github.com/adham90/opentrace/components/badge"
	"github.com/adham90/opentrace/components/button"
	"github.com/adham90/opentrace/components/card"
	"github.com/adham90/opentrace/components/form"
	"github.com/adham90/opentrace/components/input"
	"github.com/adham90/opentrace/components/label"
	"github.com/adham90/opentrace/internal/store"
	"github.com/adham90/opentrace/internal/views"
)

templ ProfilePage(data views.LayoutData, user *store.User) {
	@views.Layout(data) {
		<div class="max-w-2xl space-y-6">
			<h1 class="text-2xl font-bold tracking-tight">Profile</h1>
			if user != nil {
				<!-- Account Info -->
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Account Info
						}
					}
					@card.Content(card.ContentProps{Class: "space-y-3"}) {
						<div class="flex justify-between items-center text-sm">
							<span class="text-muted-foreground">Email</span>
							<span>{ user.Email }</span>
						</div>
						<div class="flex justify-between items-center text-sm">
							<span class="text-muted-foreground">Display Name</span>
							<span>{ user.DisplayName }</span>
						</div>
						<div class="flex justify-between items-center text-sm">
							<span class="text-muted-foreground">Role</span>
							@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
								{ string(user.Role) }
							}
						</div>
					}
				}
				<!-- MCP Access Token -->
				@card.Card() {
					@card.Header() {
						@card.Title() {
							MCP Access Token
						}
					}
					@card.Content() {
						if user.MCPEnabled {
							<p class="text-sm text-muted-foreground mb-3">
								Your personal MCP token for connecting AI tools to OpenTrace.
							</p>
							<div class="flex gap-2 items-center mb-4">
								<code id="mcp-token-display" class="flex-1 p-2 bg-muted rounded-md text-sm font-mono break-all">mcp_****...****</code>
								<button id="mcp-reveal-btn" class="shrink-0 inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 border bg-background hover:bg-accent cursor-pointer">reveal</button>
							</div>
							<!-- Tab selector for MCP config -->
							<h4 class="text-sm font-semibold mb-2">MCP Configuration</h4>
							<p class="text-sm text-muted-foreground mb-3">
								Copy this JSON into <code class="text-xs bg-muted px-1 py-0.5 rounded">~/.claude/settings.json</code> or your project's <code class="text-xs bg-muted px-1 py-0.5 rounded">.mcp.json</code> file.
							</p>
							<div class="flex mb-2">
								<button class="mcp-tab px-3 py-1.5 text-xs font-medium border rounded-l-md cursor-pointer bg-primary text-primary-foreground border-primary" data-tab="remote" id="mcp-tab-remote">Remote (URL)</button>
								<button class="mcp-tab px-3 py-1.5 text-xs font-medium border rounded-r-md cursor-pointer border-input text-muted-foreground hover:bg-accent" data-tab="local" id="mcp-tab-local">Local (stdio)</button>
							</div>
							<div id="mcp-config-remote">
								<div class="flex gap-2 items-start">
									<pre id="mcp-config-remote-display" class="flex-1 p-2 bg-muted rounded-md text-xs font-mono overflow-x-auto">
										{ `{
  "mcpServers": {
    "opentrace": {
      "type": "http",
      "url": "<origin>/mcp/sse",
      "headers": {
        "Authorization": "Bearer --------"
      }
    }
  }
}` }
									</pre>
									<button id="mcp-config-remote-copy-btn" data-config="remote" disabled class="shrink-0 inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 border bg-background hover:bg-accent cursor-pointer disabled:opacity-50">copy</button>
								</div>
								<p class="text-xs text-muted-foreground mt-1">
									Works with any remote OpenTrace deployment. Click <strong>reveal</strong> above to load your token, then copy.
								</p>
							</div>
							<div id="mcp-config-local" style="display:none">
								<div class="flex gap-2 items-start">
									<pre id="mcp-config-local-display" class="flex-1 p-2 bg-muted rounded-md text-xs font-mono overflow-x-auto">
										{ `{
  "mcpServers": {
    "opentrace": {
      "command": "opentrace",
      "args": ["mcp"],
      "env": {
        "OPENTRACE_MCP_TOKEN": "--------"
      }
    }
  }
}` }
									</pre>
									<button id="mcp-config-local-copy-btn" data-config="local" disabled class="shrink-0 inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 border bg-background hover:bg-accent cursor-pointer disabled:opacity-50">copy</button>
								</div>
								<p class="text-xs text-muted-foreground mt-1">
									Requires the <code class="text-xs bg-muted px-1 py-0.5 rounded">opentrace</code> binary installed locally. Click <strong>reveal</strong> above to load your token, then copy.
								</p>
							</div>
						} else {
							<p class="text-sm text-muted-foreground">MCP access is disabled for your account. Contact an admin to enable it.</p>
						}
					}
				}
				<!-- Change Password -->
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Change Password
						}
					}
					@card.Content() {
						<form id="password-form" class="space-y-4">
							@form.Item() {
								@label.Label(label.Props{For: "current_password"}) {
									Current Password
								}
								@input.Input(input.Props{
									ID:       "current_password",
									Name:     "current_password",
									Type:     input.TypePassword,
									Required: true,
									Class:    "max-w-sm",
								})
							}
							@form.Item() {
								@label.Label(label.Props{For: "new_password"}) {
									New Password
								}
								@input.Input(input.Props{
									ID:          "new_password",
									Name:        "new_password",
									Type:        input.TypePassword,
									Required:    true,
									Placeholder: "min 8 characters",
									Class:       "max-w-sm",
									Attributes:  templ.Attributes{"minlength": "8"},
								})
							}
							<div class="flex items-center gap-3">
								@button.Button(button.Props{Type: button.TypeSubmit}) {
									Update Password
								}
								<span id="password-status" class="text-sm"></span>
							</div>
						</form>
					}
				}
			}
		</div>
		@input.Script()
		@profileScript()
	}
}

templ profileScript() {
	<script>
		// ---- MCP Token ----
		var mcpToken = null;

		function revealToken() {
			var btn = document.getElementById('mcp-reveal-btn');
			var display = document.getElementById('mcp-token-display');
			if (!btn || !display) return;

			if (mcpToken) {
				navigator.clipboard.writeText(mcpToken);
				btn.textContent = 'copied!';
				setTimeout(function() { btn.textContent = 'copy'; }, 1500);
				return;
			}

			btn.textContent = 'loading...';
			fetch('/api/profile/mcp-token').then(function(r) {
				if (!r.ok) throw new Error('failed');
				return r.json();
			}).then(function(d) {
				mcpToken = d.mcp_token;
				display.textContent = mcpToken;
				btn.textContent = 'copy';
				updateConfigDisplays();
			}).catch(function() {
				btn.textContent = 'error';
				setTimeout(function() { btn.textContent = 'reveal'; }, 2000);
			});
		}

		function updateConfigDisplays() {
			if (!mcpToken) return;
			var remoteEl = document.getElementById('mcp-config-remote-display');
			var remoteBtn = document.getElementById('mcp-config-remote-copy-btn');
			if (remoteEl) {
				var remoteConfig = { mcpServers: { opentrace: { type: 'http', url: window.location.origin + '/mcp/sse', headers: { Authorization: 'Bearer ' + mcpToken }}}};
				remoteEl.textContent = JSON.stringify(remoteConfig, null, 2);
				remoteBtn.disabled = false;
			}
			var localEl = document.getElementById('mcp-config-local-display');
			var localBtn = document.getElementById('mcp-config-local-copy-btn');
			if (localEl) {
				var localConfig = { mcpServers: { opentrace: { command: 'opentrace', args: ['mcp'], env: { OPENTRACE_MCP_TOKEN: mcpToken }}}};
				localEl.textContent = JSON.stringify(localConfig, null, 2);
				localBtn.disabled = false;
			}
		}

		function switchMCPTab(tab, btn) {
			document.getElementById('mcp-config-remote').style.display = tab === 'remote' ? '' : 'none';
			document.getElementById('mcp-config-local').style.display = tab === 'local' ? '' : 'none';
			document.querySelectorAll('.mcp-tab').forEach(function(t) {
				t.classList.remove('bg-primary', 'text-primary-foreground', 'border-primary');
				t.classList.add('border-input', 'text-muted-foreground');
			});
			btn.classList.add('bg-primary', 'text-primary-foreground', 'border-primary');
			btn.classList.remove('border-input', 'text-muted-foreground');
		}

		function copyMCPConfig(variant, btn) {
			var el = document.getElementById('mcp-config-' + variant + '-display');
			navigator.clipboard.writeText(el.textContent);
			btn.textContent = 'copied!';
			setTimeout(function() { btn.textContent = 'copy'; }, 1500);
		}

		// ---- Change Password ----
		var pwForm = document.getElementById('password-form');
		if (pwForm) {
			pwForm.addEventListener('submit', function(e) {
				e.preventDefault();
				var status = document.getElementById('password-status');
				var current = document.getElementById('current_password').value;
				var newPw = document.getElementById('new_password').value;
				if (!current || !newPw) { status.textContent = 'Both fields required'; status.className = 'text-sm text-destructive'; return; }
				if (newPw.length < 8) { status.textContent = 'Password must be at least 8 characters'; status.className = 'text-sm text-destructive'; return; }
				status.textContent = 'Saving...'; status.className = 'text-sm text-muted-foreground';
				fetch('/api/profile/password', {
					method: 'POST', headers: {'Content-Type': 'application/json'},
					body: JSON.stringify({current_password: current, new_password: newPw})
				}).then(function(r) {
					if (r.ok) {
						status.textContent = 'Password updated'; status.className = 'text-sm text-green-500';
						pwForm.reset();
						setTimeout(function(){ status.textContent = ''; }, 3000);
					} else {
						return r.json().then(function(d) { status.textContent = 'Error: ' + (d.error || 'unknown'); status.className = 'text-sm text-destructive'; });
					}
				}).catch(function(err) { status.textContent = 'Error: ' + err.message; status.className = 'text-sm text-destructive'; });
			});
		}

		// ---- Bind event listeners ----
		var revealBtn = document.getElementById('mcp-reveal-btn');
		if (revealBtn) revealBtn.addEventListener('click', revealToken);
		document.querySelectorAll('.mcp-tab').forEach(function(btn) {
			btn.addEventListener('click', function() { switchMCPTab(btn.getAttribute('data-tab'), btn); });
		});
		document.querySelectorAll('[data-config]').forEach(function(btn) {
			btn.addEventListener('click', function() { copyMCPConfig(btn.getAttribute('data-config'), btn); });
		});
	</script>
}
