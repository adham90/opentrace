package webviews

import (
	"fmt"
	"github.com/adham90/opentrace/components/button"
	"github.com/adham90/opentrace/components/card"
	"github.com/adham90/opentrace/components/input"
	"github.com/adham90/opentrace/components/label"
	"github.com/adham90/opentrace/components/separator"
	"github.com/adham90/opentrace/internal/views"
)

// SettingsData holds all data for the settings page.
type SettingsData struct {
	CSRFToken          string
	RetentionDays      int
	MetricRetentionDays int
	EnvKeyOverride     bool
	CORSOrigins        string
	CORSEnvOverride    bool
	MaxQueryRows       int
	StatementTimeoutMS int
	QueryEnvOverride   bool
	MCPName            string
	MCPNameEnvOverride bool
}

templ SettingsPage(data views.LayoutData, settings SettingsData) {
	@views.Layout(data) {
		<div class="space-y-6 max-w-2xl">
			<h1 class="text-2xl font-bold tracking-tight">Settings</h1>
			// Data Retention
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Data Retention
					}
					@card.Description() {
						How long data is kept. 0 = forever. Default: 30 days.
					}
				}
				@card.Content() {
					<form id="retention-form" class="flex flex-wrap items-end gap-4">
						<input type="hidden" name="_csrf" value={ settings.CSRFToken }/>
						<div class="space-y-1">
							@label.Label(label.Props{For: "retention-days"}) {
								Logs (days)
							}
							@input.Input(input.Props{
								ID:    "retention-days",
								Name:  "retention_days",
								Type:  input.TypeNumber,
								Value: fmt.Sprintf("%d", settings.RetentionDays),
								Class: "w-28",
								Attributes: templ.Attributes{"min": "0", "step": "1"},
							})
						</div>
						<div class="space-y-1">
							@label.Label(label.Props{For: "metric-retention-days"}) {
								Metrics (days)
							}
							@input.Input(input.Props{
								ID:          "metric-retention-days",
								Name:        "metric_retention_days",
								Type:        input.TypeNumber,
								Value:       fmt.Sprintf("%d", settings.MetricRetentionDays),
								Placeholder: "0",
								Class:       "w-28",
								Attributes:  templ.Attributes{"min": "0", "step": "1"},
							})
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
							Save
						}
					</form>
				}
			}
			@separator.Separator()
			// API Key
			@card.Card() {
				@card.Header() {
					@card.Title() {
						API Key
					}
					@card.Description() {
						Authenticates agents sending logs and metrics.
					}
				}
				@card.Content() {
					if settings.EnvKeyOverride {
						<p class="text-xs text-yellow-500 mb-3">
							Set via <code class="bg-muted px-1 rounded">OPENTRACE_API_KEY</code> env var.
						</p>
					}
					<div class="flex items-center gap-2 mb-3">
						<code
							id="api-key-value"
							class="flex-1 bg-muted rounded px-3 py-2 text-xs font-mono cursor-pointer break-all"
						>
							Loading...
						</code>
						@button.Button(button.Props{
							Variant:    button.VariantOutline,
							Size:       button.SizeSm,
							Attributes: templ.Attributes{"id": "copy-api-key-btn"},
						}) {
							Copy
						}
					</div>
					if !settings.EnvKeyOverride {
						@button.Button(button.Props{
							Variant:    button.VariantOutline,
							Size:       button.SizeSm,
							Attributes: templ.Attributes{"id": "regen-btn"},
						}) {
							Regenerate
						}
					}
				}
			}
			@separator.Separator()
			// CORS Origins
			@card.Card() {
				@card.Header() {
					@card.Title() {
						CORS Origins
					}
					@card.Description() {
						Comma-separated origins for cross-origin API requests. * = all.
					}
				}
				@card.Content() {
					if settings.CORSEnvOverride {
						<p class="text-xs text-yellow-500 mb-3">
							Set via <code class="bg-muted px-1 rounded">OPENTRACE_CORS_ORIGINS</code> env var.
						</p>
					}
					<form id="cors-form" class="flex items-end gap-3">
						<input type="hidden" name="_csrf" value={ settings.CSRFToken }/>
						<div class="space-y-1 flex-1">
							@input.Input(input.Props{
								ID:          "cors-origins",
								Name:        "cors_origins",
								Type:        input.TypeText,
								Value:       settings.CORSOrigins,
								Placeholder: "https://example.com",
								Disabled:    settings.CORSEnvOverride,
							})
						</div>
						if !settings.CORSEnvOverride {
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
								Save
							}
						}
					</form>
				}
			}
			@separator.Separator()
			// Query Guardrails
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Query Guardrails
					}
					@card.Description() {
						Safety limits for database connector queries.
					}
				}
				@card.Content() {
					if settings.QueryEnvOverride {
						<p class="text-xs text-yellow-500 mb-3">Set via environment variables.</p>
					}
					<form id="guardrails-form" class="flex flex-wrap items-end gap-4">
						<input type="hidden" name="_csrf" value={ settings.CSRFToken }/>
						<div class="space-y-1">
							@label.Label(label.Props{For: "max-query-rows"}) {
								Max rows
							}
							@input.Input(input.Props{
								ID:       "max-query-rows",
								Name:     "max_query_rows",
								Type:     input.TypeNumber,
								Value:    fmt.Sprintf("%d", settings.MaxQueryRows),
								Class:    "w-28",
								Disabled: settings.QueryEnvOverride,
								Attributes: templ.Attributes{"min": "1", "step": "1"},
							})
						</div>
						<div class="space-y-1">
							@label.Label(label.Props{For: "statement-timeout"}) {
								Timeout (ms)
							}
							@input.Input(input.Props{
								ID:       "statement-timeout",
								Name:     "statement_timeout_ms",
								Type:     input.TypeNumber,
								Value:    fmt.Sprintf("%d", settings.StatementTimeoutMS),
								Class:    "w-28",
								Disabled: settings.QueryEnvOverride,
								Attributes: templ.Attributes{"min": "100", "step": "100"},
							})
						</div>
						if !settings.QueryEnvOverride {
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
								Save
							}
						}
					</form>
				}
			}
			@separator.Separator()
			// MCP Server Name
			@card.Card() {
				@card.Header() {
					@card.Title() {
						MCP Server Name
					}
					@card.Description() {
						Name reported during MCP initialization.
					}
				}
				@card.Content() {
					if settings.MCPNameEnvOverride {
						<p class="text-xs text-yellow-500 mb-3">
							Set via <code class="bg-muted px-1 rounded">OPENTRACE_MCP_NAME</code> env var.
						</p>
					}
					<form id="mcp-name-form" class="flex items-end gap-3">
						<input type="hidden" name="_csrf" value={ settings.CSRFToken }/>
						<div class="space-y-1">
							@input.Input(input.Props{
								ID:          "mcp-name",
								Name:        "mcp_name",
								Type:        input.TypeText,
								Value:       settings.MCPName,
								Placeholder: "opentrace",
								Disabled:    settings.MCPNameEnvOverride,
								Class:       "w-48",
							})
						</div>
						if !settings.MCPNameEnvOverride {
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
								Save
							}
						}
					</form>
				}
			}
			@separator.Separator()
			// Version
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Version
					}
				}
				@card.Content() {
					<div class="flex flex-wrap gap-3 text-sm font-mono">
						<span class="text-muted-foreground">current:</span>
						<strong id="ver-current">loading...</strong>
						<span class="text-muted-foreground">commit:</span>
						<code id="ver-commit">...</code>
						<span class="text-muted-foreground">built:</span>
						<span id="ver-date">...</span>
					</div>
					<div id="ver-status" class="mt-2"></div>
					<div class="mt-3">
						@button.Button(button.Props{
							Variant:    button.VariantOutline,
							Size:       button.SizeSm,
							Attributes: templ.Attributes{"id": "ver-check-btn"},
						}) {
							Check for updates
						}
					</div>
				}
			}
			@separator.Separator()
			// Logout
			<form method="POST" action="/logout">
				<input type="hidden" name="_csrf" value={ settings.CSRFToken }/>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
					Logout
				}
			</form>
		</div>
		@settingsScript()
	}
}

templ settingsScript() {
	<script>
	(function() {
		// API Key
		var apiKeyData = {key: '', visible: false};
		function loadAPIKey() {
			fetch('/api/settings/api-key').then(r => r.json()).then(d => {
				apiKeyData.key = d.api_key || '';
				renderKeyDisplay();
			}).catch(() => {
				document.getElementById('api-key-value').textContent = 'Failed to load';
			});
		}
		function renderKeyDisplay() {
			var el = document.getElementById('api-key-value');
			if (!el || !apiKeyData.key) { if (el) el.textContent = 'No API key configured'; return; }
			el.textContent = apiKeyData.visible ? apiKeyData.key : apiKeyData.key.substring(0, 6) + '________________';
		}
		var keyEl = document.getElementById('api-key-value');
		if (keyEl) keyEl.addEventListener('click', () => { apiKeyData.visible = !apiKeyData.visible; renderKeyDisplay(); });
		var copyBtn = document.getElementById('copy-api-key-btn');
		if (copyBtn) copyBtn.addEventListener('click', () => { if (apiKeyData.key) navigator.clipboard.writeText(apiKeyData.key); });
		var regenBtn = document.getElementById('regen-btn');
		if (regenBtn) regenBtn.addEventListener('click', () => {
			if (!confirm('Regenerate the API key? All existing agents will stop working until updated.')) return;
			fetch('/api/settings/api-key', {method: 'POST'}).then(r => r.json()).then(d => {
				apiKeyData.key = d.api_key; apiKeyData.visible = true; renderKeyDisplay();
			});
		});
		loadAPIKey();

		// Retention
		var retForm = document.getElementById('retention-form');
		if (retForm) retForm.addEventListener('submit', e => {
			e.preventDefault();
			var days = parseInt(document.getElementById('retention-days').value, 10);
			var metricDays = parseInt(document.getElementById('metric-retention-days').value, 10) || 0;
			fetch('/api/settings/retention', {
				method: 'PUT', headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({retention_days: days, metric_retention_days: metricDays})
			});
		});

		// CORS
		var corsForm = document.getElementById('cors-form');
		if (corsForm) corsForm.addEventListener('submit', e => {
			e.preventDefault();
			fetch('/api/settings/cors', {
				method: 'PUT', headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({cors_origins: document.getElementById('cors-origins').value.trim()})
			});
		});

		// Guardrails
		var grForm = document.getElementById('guardrails-form');
		if (grForm) grForm.addEventListener('submit', e => {
			e.preventDefault();
			fetch('/api/settings/query-guardrails', {
				method: 'PUT', headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({
					max_query_rows: parseInt(document.getElementById('max-query-rows').value, 10),
					statement_timeout_ms: parseInt(document.getElementById('statement-timeout').value, 10)
				})
			});
		});

		// MCP Name
		var mcpForm = document.getElementById('mcp-name-form');
		if (mcpForm) mcpForm.addEventListener('submit', e => {
			e.preventDefault();
			fetch('/api/settings/mcp-name', {
				method: 'PUT', headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({mcp_name: document.getElementById('mcp-name').value.trim()})
			});
		});

		// Version
		fetch('/api/version').then(r => r.json()).then(d => {
			document.getElementById('ver-current').textContent = d.version;
			document.getElementById('ver-commit').textContent = d.commit === 'unknown' ? '-' : d.commit.substring(0, 7);
			document.getElementById('ver-date').textContent = d.date === 'unknown' ? '-' : d.date;
		});
		var verBtn = document.getElementById('ver-check-btn');
		if (verBtn) verBtn.addEventListener('click', () => {
			fetch('/api/version/check?force=1').then(r => r.json()).then(d => {
				var el = document.getElementById('ver-status');
				if (d.update_available) {
					el.innerHTML = '<span class="text-green-500">Update available: <strong>v' + d.latest_version + '</strong></span>';
				} else {
					el.innerHTML = '<span class="text-green-500">Up to date.</span>';
				}
			});
		});
	})();
	</script>
}
