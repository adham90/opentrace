package webviews

import (
	"fmt"
	"github.com/adham90/opentrace/components/badge"
	"github.com/adham90/opentrace/components/breadcrumb"
	"github.com/adham90/opentrace/components/button"
	"github.com/adham90/opentrace/components/card"
	"github.com/adham90/opentrace/components/table"
	"github.com/adham90/opentrace/internal/store"
	"github.com/adham90/opentrace/internal/views"
)

// WatcherDetailData holds all data for the watcher detail page.
type WatcherDetailData struct {
	Watch   *store.Watch
	Runs    []store.WatchRun
	Alerts  []store.WatchAlert
	Session *store.InvestigationSession
}

templ WatcherDetailPage(data views.LayoutData, detail WatcherDetailData) {
	@views.Layout(data) {
		<div class="space-y-6">
			// Breadcrumb
			@breadcrumb.Breadcrumb() {
				@breadcrumb.List() {
					@breadcrumb.Item() {
						@breadcrumb.Link(breadcrumb.LinkProps{Href: "/watchers"}) {
							Watchers
						}
					}
					@breadcrumb.Separator()
					@breadcrumb.Item(breadcrumb.ItemProps{Current: true}) {
						{ string(detail.Watch.Metric) }
					}
				}
			}
			if detail.Watch != nil {
				// Status summary
				@card.Card() {
					@card.Content(card.ContentProps{Class: "p-4"}) {
						<div class="flex flex-wrap items-center gap-3 text-sm">
							<div class="flex items-center gap-1.5">
								<span class="text-muted-foreground">status:</span>
								@watchStatusBadge(string(detail.Watch.Status))
							</div>
							<div class="flex items-center gap-1.5">
								<span class="text-muted-foreground">urgency:</span>
								@watchUrgencyBadge(string(detail.Watch.Urgency))
							</div>
							if detail.Watch.Service != "" {
								<div class="flex items-center gap-1.5">
									<span class="text-muted-foreground">service:</span>
									@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
										{ detail.Watch.Service }
									}
								</div>
							}
							if detail.Watch.Endpoint != "" {
								<div class="flex items-center gap-1.5">
									<span class="text-muted-foreground">endpoint:</span>
									<code class="text-xs">{ detail.Watch.Endpoint }</code>
								</div>
							}
							<div class="flex items-center gap-1.5">
								<span class="text-muted-foreground">breaches:</span>
								<strong>{ fmt.Sprintf("%d", detail.Watch.ConsecutiveBreaches) }</strong>
							</div>
							<div class="flex items-center gap-1.5">
								<span class="text-muted-foreground">created:</span>
								{ views.TimeAgo(detail.Watch.CreatedAt) }
							</div>
							if detail.Watch.CreatedBy != "" {
								<div class="flex items-center gap-1.5">
									<span class="text-muted-foreground">by:</span>
									{ detail.Watch.CreatedBy }
								</div>
							}
						</div>
					}
				}
				// Threshold rule
				@card.Card() {
					@card.Content(card.ContentProps{Class: "p-4"}) {
						<div class="flex items-center gap-3 font-mono text-base">
							<span class="text-blue-400 font-semibold">{ string(detail.Watch.Metric) }</span>
							<span class="text-muted-foreground">{ string(detail.Watch.Operator) }</span>
							<span class="text-destructive font-semibold">{ fmt.Sprintf("%.1f", detail.Watch.Threshold) }</span>
							if detail.Watch.CurrentValue != nil {
								<span class="text-muted-foreground mx-1">--</span>
								<span class="text-muted-foreground">current:</span>
								<span class={ "font-semibold", templ.KV("text-destructive", detail.Watch.ConsecutiveBreaches > 0), templ.KV("text-green-500", detail.Watch.ConsecutiveBreaches == 0) }>
									{ fmt.Sprintf("%.1f", *detail.Watch.CurrentValue) }
								</span>
							}
						</div>
					}
				}
				// Configuration
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
					@watchConfigCard("Check Interval", detail.Watch.CheckInterval)
					@watchConfigCard("Duration", nonEmpty(detail.Watch.Duration, "--"))
					@watchConfigCard("Min Consecutive", fmt.Sprintf("%d", detail.Watch.MinConsecutive))
					if detail.Watch.LastCheckedAt != nil {
						@watchConfigCard("Last Checked", views.TimeAgo(*detail.Watch.LastCheckedAt))
					}
					if detail.Watch.ExpiresAt != nil {
						@watchConfigCard("Expires", views.TimeAgo(*detail.Watch.ExpiresAt))
					}
					if detail.Watch.BaselineWindow != "" {
						@watchConfigCard("Baseline Window", detail.Watch.BaselineWindow)
					}
				</div>
				// Session linkage
				if detail.Session != nil {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/sessions/%s", detail.Session.ID)) }
						class="flex items-center gap-2 rounded-lg border p-3 bg-muted/30 hover:bg-muted/50 transition-colors no-underline text-sm"
					>
						<span class="inline-block w-2 h-2 rounded-full bg-green-500"></span>
						<span>
							Created during investigation session:
							if detail.Session.Summary != "" {
								<strong>{ truncateID(detail.Session.Summary, 60) }</strong>
							} else {
								<strong>{ detail.Session.ID }</strong>
							}
						</span>
					</a>
				}
			}
			// Alerts
			if len(detail.Alerts) > 0 {
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Alerts
							<span class="text-muted-foreground font-normal text-sm ml-1">
								{ fmt.Sprintf("(%d)", len(detail.Alerts)) }
							</span>
						}
					}
					@card.Content(card.ContentProps{Class: "p-0"}) {
						<div class="divide-y" id="alerts-container">
							for _, a := range detail.Alerts {
								@watchAlertRow(a)
							}
						</div>
					}
				}
			}
			// Execution history
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Execution History
						if len(detail.Runs) > 0 {
							<span class="text-muted-foreground font-normal text-sm ml-1">
								{ fmt.Sprintf("(%d)", len(detail.Runs)) }
							</span>
						}
					}
				}
				@card.Content(card.ContentProps{Class: "p-0"}) {
					if len(detail.Runs) > 0 {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head(table.HeadProps{Class: "w-3"}) {
									}
									@table.Head() {
										Metric Value
									}
									@table.Head() {
										Breached
									}
									@table.Head() {
										Summary
									}
									@table.Head() {
										Started
									}
									@table.Head() {
										Finished
									}
								}
							}
							@table.Body() {
								for _, run := range detail.Runs {
									@watchRunRow(run)
								}
							}
						}
					} else {
						<div class="py-12 text-center text-muted-foreground">
							No runs recorded yet.
						</div>
					}
				}
			}
		</div>
		@watcherDetailScript()
	}
}

templ watchConfigCard(label, value string) {
	@card.Card() {
		@card.Content(card.ContentProps{Class: "p-3"}) {
			<div class="text-[10px] text-muted-foreground uppercase tracking-wider">{ label }</div>
			<div class="text-sm font-semibold font-mono mt-0.5">{ value }</div>
		}
	}
}

templ watchStatusBadge(status string) {
	switch status {
		case "active":
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-green-500 border-green-500/30 bg-green-500/10"}) {
				active
			}
		case "triggered":
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive, Class: "text-[10px]"}) {
				triggered
			}
		case "expired":
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-muted-foreground"}) {
				expired
			}
		case "resolved":
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-green-500 border-green-500/30"}) {
				resolved
			}
		default:
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px]"}) {
				{ status }
			}
	}
}

templ watchUrgencyBadge(urgency string) {
	switch urgency {
		case "critical":
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive, Class: "text-[10px]"}) {
				critical
			}
		case "high":
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-yellow-500 border-yellow-500/30"}) {
				high
			}
		case "normal":
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-blue-400 border-blue-400/30"}) {
				normal
			}
		default:
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-muted-foreground"}) {
				{ urgency }
			}
	}
}

templ watchAlertRow(a store.WatchAlert) {
	<div class="group" data-alert-id={ a.ID }>
		<div
			class="flex items-center gap-3 px-4 py-3 cursor-pointer hover:bg-muted/50 transition-colors"
			data-toggle-alert={ a.ID }
		>
			<span class={ "inline-block w-2 h-2 rounded-full shrink-0",
				templ.KV("bg-yellow-500", a.Status == "pending"),
				templ.KV("bg-muted-foreground", a.Status == "dismissed"),
				templ.KV("bg-green-500", a.Status != "pending" && a.Status != "dismissed"),
			}></span>
			<span class="text-sm font-medium truncate flex-1">{ a.Summary }</span>
			<div class="flex items-center gap-3 text-xs text-muted-foreground shrink-0">
				@watchUrgencyBadge(string(a.Urgency))
				<span class="font-mono">
					{ fmt.Sprintf("%.1f / %.1f", a.TriggerValue, a.ThresholdValue) }
				</span>
				@alertStatusBadge(a.Status)
				<span>{ views.TimeAgo(a.CreatedAt) }</span>
				if a.Status == "pending" {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeSm,
						Attributes: templ.Attributes{"data-dismiss-alert": a.ID},
					}) {
						Dismiss
					}
				}
			</div>
		</div>
		<div class="hidden bg-muted/30 border-t px-4 py-3" id={ fmt.Sprintf("alert-evidence-%s", a.ID) }>
			<span class="text-sm text-muted-foreground">Loading evidence...</span>
		</div>
	</div>
}

templ alertStatusBadge(status string) {
	switch status {
		case "pending":
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-yellow-500 border-yellow-500/30"}) {
				pending
			}
		case "dismissed":
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-muted-foreground"}) {
				dismissed
			}
		default:
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-green-500"}) {
				{ status }
			}
	}
}

templ watchRunRow(run store.WatchRun) {
	@table.Row() {
		@table.Cell() {
			<span class={ "inline-block w-2 h-2 rounded-full",
				templ.KV("bg-red-500", run.Status == "completed" && run.Breached),
				templ.KV("bg-green-500", run.Status == "completed" && !run.Breached),
				templ.KV("bg-yellow-500", run.Status == "failed"),
				templ.KV("bg-muted-foreground", run.Status != "completed" && run.Status != "failed"),
			}></span>
		}
		@table.Cell(table.CellProps{Class: "font-semibold font-mono"}) {
			if run.MetricValue != nil {
				{ fmt.Sprintf("%.2f", *run.MetricValue) }
			} else {
				<span class="text-muted-foreground">--</span>
			}
		}
		@table.Cell() {
			if run.Breached {
				<span class="text-destructive font-semibold">yes</span>
			} else {
				<span class="text-green-500">no</span>
			}
		}
		@table.Cell(table.CellProps{Class: "text-muted-foreground text-xs max-w-[300px] truncate"}) {
			if run.Summary != "" {
				{ truncateID(run.Summary, 80) }
			} else if run.ErrorMessage != "" {
				<span class="text-destructive">{ truncateID(run.ErrorMessage, 80) }</span>
			} else {
				<span>--</span>
			}
		}
		@table.Cell(table.CellProps{Class: "text-xs text-muted-foreground whitespace-nowrap"}) {
			{ run.StartedAt.Format("Jan 02 15:04:05") }
		}
		@table.Cell(table.CellProps{Class: "text-xs text-muted-foreground"}) {
			if run.FinishedAt != nil {
				{ run.FinishedAt.Format("15:04:05") }
			} else {
				<span class="text-yellow-500">running</span>
			}
		}
	}
}

templ watcherDetailScript() {
	<script>
	(function() {
		// Toggle alerts
		document.querySelectorAll('[data-toggle-alert]').forEach(function(row) {
			row.addEventListener('click', function(e) {
				if (e.target.closest('[data-dismiss-alert]')) return;
				var alertId = row.dataset.toggleAlert;
				var evidence = document.getElementById('alert-evidence-' + alertId);
				if (!evidence) return;
				var isOpen = !evidence.classList.contains('hidden');
				document.querySelectorAll('[id^="alert-evidence-"]').forEach(function(d) { d.classList.add('hidden'); });
				if (!isOpen) {
					evidence.classList.remove('hidden');
					if (!evidence.dataset.loaded) {
						fetch('/api/watches/alerts/' + alertId).then(r => r.json()).then(function(data) {
							evidence.dataset.loaded = '1';
							var ev = data.evidence;
							if (!ev) { evidence.innerHTML = '<span class="text-sm text-muted-foreground">No evidence data</span>'; return; }
							var html = '';
							if (ev.recent_errors && ev.recent_errors.length > 0) {
								html += '<div class="mb-3"><div class="text-[10px] font-semibold text-muted-foreground uppercase mb-1">Recent Errors</div>';
								ev.recent_errors.forEach(function(err) {
									html += '<div class="text-xs py-1 border-b last:border-0"><strong class="text-destructive">' + err.exception_class + '</strong> - ' + err.message + '</div>';
								});
								html += '</div>';
							}
							if (ev.relevant_logs && ev.relevant_logs.length > 0) {
								html += '<div class="mb-3"><div class="text-[10px] font-semibold text-muted-foreground uppercase mb-1">Relevant Logs</div>';
								ev.relevant_logs.slice(0, 5).forEach(function(log) {
									html += '<div class="text-xs py-1 border-b last:border-0">' + log.level + ' ' + (log.service || '') + ' ' + log.message.substring(0, 100) + '</div>';
								});
								html += '</div>';
							}
							evidence.innerHTML = html || '<span class="text-sm text-muted-foreground">No evidence collected</span>';
						}).catch(function() {
							evidence.innerHTML = '<span class="text-sm text-muted-foreground">Failed to load evidence</span>';
						});
					}
				}
			});
		});

		// Dismiss alerts
		document.querySelectorAll('[data-dismiss-alert]').forEach(function(btn) {
			btn.addEventListener('click', function(e) {
				e.stopPropagation();
				var alertId = btn.dataset.dismissAlert;
				fetch('/api/watches/alerts/' + alertId + '/dismiss', {
					method: 'POST',
					headers: {'Content-Type': 'application/json'},
					body: JSON.stringify({reason: 'dismissed from UI'})
				}).then(function(r) { if (r.ok) location.reload(); });
			});
		});
	})();
	</script>
}

func nonEmpty(s, fallback string) string {
	if s == "" {
		return fallback
	}
	return s
}
