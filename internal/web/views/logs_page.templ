package webviews

import (
	"fmt"
	"github.com/adham90/opentrace/components/badge"
	"github.com/adham90/opentrace/components/button"
	"github.com/adham90/opentrace/components/card"
	"github.com/adham90/opentrace/components/input"
	"github.com/adham90/opentrace/components/label"
	"github.com/adham90/opentrace/components/table"
	"github.com/adham90/opentrace/internal/store"
	"github.com/adham90/opentrace/internal/views"
)

// LogFilters holds the current filter state for the logs page.
type LogFilters struct {
	Query            string
	Service          string
	Level            string
	EventType        string
	TimeRange        string
	Environment      string
	CommitHash       string
	RequestID        string
	TraceID          string
	ExceptionClass   string
	ErrorFingerprint string
	SourceFile       string
}

// LogsPageData holds all data for the logs page.
type LogsPageData struct {
	Filters  LogFilters
	Logs     []store.LogEntry
	MaxLogID int64
	HasMore  bool
}

templ LogsPage(data views.LayoutData, page LogsPageData) {
	@views.Layout(data) {
		<div class="space-y-4">
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-bold tracking-tight">Logs</h1>
			</div>
			// Filter bar
			@card.Card() {
				@card.Content(card.ContentProps{Class: "p-4"}) {
					<form
						id="log-filter-form"
						hx-get="/logs"
						hx-target="#logs-table-body"
						hx-swap="innerHTML"
						hx-push-url="true"
						class="flex flex-wrap items-end gap-3"
					>
						<div class="space-y-1">
							@label.Label(label.Props{For: "f-service"}) {
								Service
							}
							@input.Input(input.Props{
								ID:          "f-service",
								Name:        "service",
								Type:        input.TypeText,
								Placeholder: "all services",
								Value:       page.Filters.Service,
								Class:       "w-36",
							})
						</div>
						<div class="space-y-1">
							@label.Label(label.Props{For: "f-level"}) {
								Level
							}
							<select
								id="f-level"
								name="level"
								class="flex h-9 w-28 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
							>
								<option value="">all</option>
								<option value="ERROR" selected?={ page.Filters.Level == "ERROR" }>ERROR</option>
								<option value="WARN" selected?={ page.Filters.Level == "WARN" }>WARN</option>
								<option value="INFO" selected?={ page.Filters.Level == "INFO" }>INFO</option>
								<option value="DEBUG" selected?={ page.Filters.Level == "DEBUG" }>DEBUG</option>
							</select>
						</div>
						<div class="space-y-1">
							@label.Label(label.Props{For: "f-time-range"}) {
								Time Range
							}
							<select
								id="f-time-range"
								name="time_range"
								class="flex h-9 w-24 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
							>
								<option value="">all</option>
								<option value="15m" selected?={ page.Filters.TimeRange == "15m" }>15m</option>
								<option value="1h" selected?={ page.Filters.TimeRange == "1h" }>1h</option>
								<option value="6h" selected?={ page.Filters.TimeRange == "6h" }>6h</option>
								<option value="24h" selected?={ page.Filters.TimeRange == "24h" }>24h</option>
								<option value="7d" selected?={ page.Filters.TimeRange == "7d" }>7d</option>
							</select>
						</div>
						<div class="space-y-1 flex-1 min-w-[200px]">
							@label.Label(label.Props{For: "f-query"}) {
								Search
							}
							@input.Input(input.Props{
								ID:          "f-query",
								Name:        "query",
								Type:        input.TypeSearch,
								Placeholder: "search logs...",
								Value:       page.Filters.Query,
							})
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
							Filter
						}
					</form>
					// Active filter chips
					if hasActiveFilters(page.Filters) {
						<div class="flex flex-wrap gap-2 mt-3 pt-3 border-t">
							if page.Filters.Service != "" {
								@filterChip("service", page.Filters.Service)
							}
							if page.Filters.Level != "" {
								@filterChip("level", page.Filters.Level)
							}
							if page.Filters.TimeRange != "" {
								@filterChip("time", page.Filters.TimeRange)
							}
							if page.Filters.Query != "" {
								@filterChip("query", page.Filters.Query)
							}
							if page.Filters.ExceptionClass != "" {
								@filterChip("exception", page.Filters.ExceptionClass)
							}
							if page.Filters.TraceID != "" {
								@filterChip("trace", page.Filters.TraceID)
							}
						</div>
					}
				}
			}
			// HTMX polling container
			<div
				id="logs-container"
				hx-get="/api/logs/poll"
				hx-trigger="every 5s"
				hx-target="#logs-table-body"
				hx-swap="afterbegin"
			>
				// Logs table
				@card.Card() {
					@card.Content(card.ContentProps{Class: "p-0"}) {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head(table.HeadProps{Class: "w-[140px]"}) {
										Timestamp
									}
									@table.Head(table.HeadProps{Class: "w-[70px]"}) {
										Level
									}
									@table.Head(table.HeadProps{Class: "w-[120px]"}) {
										Service
									}
									@table.Head() {
										Message
									}
								}
							}
							@table.Body(table.BodyProps{ID: "logs-table-body"}) {
								for _, log := range page.Logs {
									@logRow(log)
								}
							}
						}
						if len(page.Logs) == 0 {
							<div class="py-12 text-center text-muted-foreground">
								No logs found matching the current filters.
							</div>
						}
					}
				}
			</div>
		</div>
	}
}

templ logRow(log store.LogEntry) {
	<tr class="cursor-pointer hover:bg-muted/50 transition-colors" onclick="this.nextElementSibling?.classList.toggle('hidden')">
		<td class="p-3 font-mono text-xs text-muted-foreground whitespace-nowrap align-top">
			{ log.Timestamp.Format("15:04:05.000") }
		</td>
		<td class="p-3 align-top">
			@logLevelBadge(log.Level)
		</td>
		<td class="p-3 text-xs text-muted-foreground truncate max-w-[120px] align-top">
			{ log.Service }
		</td>
		<td class="p-3 text-sm truncate max-w-[500px] align-top">
			<span class={ templ.KV("text-destructive", log.Level == "ERROR") }>
				{ truncateStr(log.Message, 120) }
			</span>
			if log.ExceptionClass != "" {
				<span class="text-xs text-destructive/60 ml-1">{ log.ExceptionClass }</span>
			}
		</td>
	</tr>
	// Expandable detail row (hidden by default)
	<tr class="hidden bg-muted/30">
		<td colspan="4" class="p-4">
			@logDetail(log)
		</td>
	</tr>
}

templ logDetail(log store.LogEntry) {
	<div class="space-y-3 text-sm">
		<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
			if log.Service != "" {
				@logDetailField("Service", log.Service)
			}
			if log.Environment != "" {
				@logDetailField("Environment", log.Environment)
			}
			if log.TraceID != "" {
				@logDetailField("Trace ID", log.TraceID)
			}
			if log.RequestID != "" {
				@logDetailField("Request ID", log.RequestID)
			}
			if log.ExceptionClass != "" {
				@logDetailField("Exception", log.ExceptionClass)
			}
			if log.SourceFile != "" {
				@logDetailField("Source", fmt.Sprintf("%s:%d", log.SourceFile, log.SourceLine))
			}
			if log.CommitHash != "" {
				@logDetailField("Commit", log.CommitHash)
			}
			if log.EventType != "" {
				@logDetailField("Event Type", log.EventType)
			}
		</div>
		<div class="rounded border bg-background p-3 font-mono text-xs whitespace-pre-wrap break-all max-h-64 overflow-y-auto">
			{ log.Message }
		</div>
	</div>
}

templ logDetailField(label, value string) {
	<div>
		<div class="text-xs text-muted-foreground">{ label }</div>
		<div class="font-mono text-xs mt-0.5 truncate">{ value }</div>
	</div>
}

templ logLevelBadge(level string) {
	switch level {
		case "ERROR":
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive, Class: "text-[10px]"}) {
				ERROR
			}
		case "WARN":
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-yellow-500 border-yellow-500/30"}) {
				WARN
			}
		case "INFO":
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-[10px]"}) {
				INFO
			}
		default:
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-muted-foreground"}) {
				{ level }
			}
	}
}

templ filterChip(key, value string) {
	<span class="inline-flex items-center gap-1 text-xs rounded-md bg-muted px-2 py-0.5 font-mono">
		<span class="text-muted-foreground">{ key }:</span>
		{ truncateStr(value, 20) }
	</span>
}

func hasActiveFilters(f LogFilters) bool {
	return f.Service != "" || f.Level != "" || f.TimeRange != "" || f.Query != "" ||
		f.ExceptionClass != "" || f.TraceID != "" || f.ErrorFingerprint != "" ||
		f.Environment != "" || f.CommitHash != ""
}

func truncateStr(s string, n int) string {
	if len(s) <= n {
		return s
	}
	return s[:n] + "..."
}

