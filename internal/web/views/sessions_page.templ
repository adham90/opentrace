package webviews

import (
	"fmt"
	"github.com/adham90/opentrace/components/badge"
	"github.com/adham90/opentrace/components/card"
	"github.com/adham90/opentrace/components/table"
	"github.com/adham90/opentrace/internal/store"
	"github.com/adham90/opentrace/internal/views"
)

// SessionsPageData holds data for the sessions list page.
type SessionsPageData struct {
	Sessions []store.InvestigationSession
	Stats    *store.InvestigationSessionStats
	Status   string // current filter status
}

templ SessionsPage(data views.LayoutData, page SessionsPageData) {
	@views.Layout(data) {
		<div class="space-y-6">
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-bold tracking-tight">Investigation Sessions</h1>
				<select
					id="status-filter"
					class="bg-transparent border rounded px-2 py-1 text-sm font-mono"
				>
					<option value="">all statuses</option>
					<option value="open" selected?={ page.Status == "open" }>open</option>
					<option value="resolved" selected?={ page.Status == "resolved" }>resolved</option>
					<option value="unresolved" selected?={ page.Status == "unresolved" }>unresolved</option>
					<option value="abandoned" selected?={ page.Status == "abandoned" }>abandoned</option>
				</select>
			</div>
			// Stats bar
			if page.Stats != nil {
				<div class="grid grid-cols-2 md:grid-cols-5 gap-4">
					@sessionStatCard("Total", fmt.Sprintf("%d", page.Stats.TotalSessions), "")
					@sessionStatCard("Open", fmt.Sprintf("%d", page.Stats.OpenSessions), "text-yellow-500")
					@sessionStatCard("Resolved", fmt.Sprintf("%d", page.Stats.ResolvedSessions), "text-green-500")
					@sessionStatCard("Avg Steps", fmt.Sprintf("%.1f", page.Stats.AvgSteps), "")
					@sessionStatCard("Avg Duration", fmt.Sprintf("%.0fs", page.Stats.AvgDurationSecs), "")
				</div>
			}
			// Sessions table
			if len(page.Sessions) > 0 {
				@card.Card() {
					@card.Content(card.ContentProps{Class: "p-0"}) {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head(table.HeadProps{Class: "w-[90px]"}) {
										ID
									}
									@table.Head() {
										User
									}
									@table.Head() {
										Client
									}
									@table.Head() {
										Intent
									}
									@table.Head(table.HeadProps{Class: "text-right"}) {
										Steps
									}
									@table.Head() {
										Status
									}
									@table.Head(table.HeadProps{Class: "text-right"}) {
										Duration
									}
									@table.Head() {
										Started
									}
								}
							}
							@table.Body() {
								for _, s := range page.Sessions {
									@sessionRow(s)
								}
							}
						}
					}
				}
			} else {
				@card.Card() {
					@card.Content(card.ContentProps{Class: "py-12 text-center"}) {
						<p class="text-lg font-medium text-muted-foreground">No investigation sessions yet</p>
						<p class="text-sm text-muted-foreground mt-1">Sessions are created when an MCP client connects and starts investigating.</p>
					}
				}
			}
		</div>
		@sessionsScript()
	}
}

templ sessionRow(s store.InvestigationSession) {
	@table.Row(table.RowProps{
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"onclick": fmt.Sprintf("window.location.href='/sessions/%s'", s.ID),
		},
	}) {
		@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
			<code class="text-blue-400">{ truncateID(s.ID, 8) }</code>
		}
		@table.Cell(table.CellProps{Class: "text-sm"}) {
			if s.UserEmail != "" {
				{ s.UserEmail }
			} else {
				<span class="text-muted-foreground">-</span>
			}
		}
		@table.Cell(table.CellProps{Class: "text-xs text-muted-foreground"}) {
			if s.ClientName != "" {
				<code>{ s.ClientName }</code>
			} else {
				<span class="text-muted-foreground">-</span>
			}
		}
		@table.Cell() {
			if s.Intent != "" {
				<span class="font-mono text-sm text-blue-400">{ truncateID(s.Intent, 40) }</span>
			} else {
				<span class="text-muted-foreground text-sm">unknown</span>
			}
		}
		@table.Cell(table.CellProps{Class: "text-right font-mono text-sm"}) {
			{ fmt.Sprintf("%d", s.TotalSteps) }
		}
		@table.Cell() {
			@sessionStatusBadge(string(s.Status))
		}
		@table.Cell(table.CellProps{Class: "text-right text-sm text-muted-foreground"}) {
			if s.DurationSeconds > 0 {
				{ fmtDuration(s.DurationSeconds) }
			} else {
				<span class="text-muted-foreground">-</span>
			}
		}
		@table.Cell(table.CellProps{Class: "text-xs text-muted-foreground whitespace-nowrap"}) {
			{ views.TimeAgo(s.StartedAt) }
		}
	}
}

templ sessionStatCard(label, value, colorClass string) {
	@card.Card() {
		@card.Content(card.ContentProps{Class: "p-3 text-center"}) {
			<div class={ "text-xl font-bold font-mono", colorClass }>{ value }</div>
			<div class="text-[10px] text-muted-foreground uppercase tracking-wider mt-0.5">{ label }</div>
		}
	}
}

templ sessionStatusBadge(status string) {
	switch status {
		case "open":
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-yellow-500 border-yellow-500/30"}) {
				open
			}
		case "resolved":
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-green-500 border-green-500/30"}) {
				resolved
			}
		case "unresolved":
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-red-500 border-red-500/30"}) {
				unresolved
			}
		default:
			@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-muted-foreground"}) {
				{ status }
			}
	}
}

templ sessionsScript() {
	<script>
	(function() {
		var sel = document.getElementById('status-filter');
		if (sel) {
			sel.addEventListener('change', function() {
				var url = '/sessions';
				if (sel.value) url += '?status=' + encodeURIComponent(sel.value);
				window.location.href = url;
			});
		}
	})();
	</script>
}

func truncateID(s string, n int) string {
	if len(s) <= n {
		return s
	}
	return s[:n]
}

func fmtDuration(secs int) string {
	if secs < 60 {
		return fmt.Sprintf("%ds", secs)
	}
	if secs < 3600 {
		return fmt.Sprintf("%dm %ds", secs/60, secs%60)
	}
	return fmt.Sprintf("%dh %dm", secs/3600, (secs%3600)/60)
}
