package webviews

import (
	"github.com/adham90/opentrace/components/accordion"
	"github.com/adham90/opentrace/components/card"
	"github.com/adham90/opentrace/internal/views"
)

// SetupData holds data for the setup page.
type SetupData struct {
	APIKey string
}

templ SetupPage(data views.LayoutData, setup SetupData) {
	@views.Layout(data) {
		<div class="space-y-6 max-w-2xl">
			<h1 class="text-2xl font-bold tracking-tight">Setup</h1>
			// Step 1: Install
			@setupStep("1", "Install") {
				<div class="rounded border bg-muted/50 p-3 relative group">
					<button class="absolute top-2 right-2 text-xs text-muted-foreground border rounded px-2 py-0.5 hover:text-foreground opacity-0 group-hover:opacity-100 transition-opacity copy-btn">
						copy
					</button>
					<pre class="font-mono text-sm overflow-x-auto"><code>go install github.com/adham90/opentrace/cmd/opentrace@latest</code></pre>
				</div>
			}
			// Step 2: Connect MCP Client
			@setupStep("2", "Connect your MCP client") {
				<div class="flex gap-0 mb-3" id="client-picker">
					<button class="setup-client-btn active px-3 py-1 text-xs font-mono border rounded-l-md bg-muted/50" data-client="claude">Claude Code</button>
					<button class="setup-client-btn px-3 py-1 text-xs font-mono border-y border-r" data-client="cursor">Cursor</button>
					<button class="setup-client-btn px-3 py-1 text-xs font-mono border-y border-r" data-client="windsurf">Windsurf</button>
					<button class="setup-client-btn px-3 py-1 text-xs font-mono border-y border-r rounded-r-md" data-client="other">Other</button>
				</div>
				<p class="text-xs text-muted-foreground mb-2" id="client-hint">
					Add to <code class="bg-muted px-1 rounded">.mcp.json</code> or <code class="bg-muted px-1 rounded">~/.claude.json</code>
				</p>
				<div class="rounded border bg-muted/50 p-3 relative group">
					<button class="absolute top-2 right-2 text-xs text-muted-foreground border rounded px-2 py-0.5 hover:text-foreground opacity-0 group-hover:opacity-100 transition-opacity copy-btn">
						copy
					</button>
					<pre class="font-mono text-sm overflow-x-auto"><code id="mcp-config">{ `{
  "mcpServers": {
    "opentrace": {
      "command": "opentrace",
      "args": ["mcp"]
    }
  }
}` }</code></pre>
				</div>
			}
			// Step 3: Verify
			@setupStep("3", "Verify") {
				<p class="text-sm text-muted-foreground">
					Ask your agent to run <code class="bg-muted px-1 rounded">list_connectors</code> -- it should return your configured data sources.
				</p>
				<p class="text-sm text-muted-foreground mt-2">
					See all <a href="/tools" class="underline">available MCP tools</a>.
				</p>
			}
			// Extras
			@card.Card() {
				@card.Content() {
					@accordion.Accordion() {
						@accordion.Item() {
							@accordion.Trigger() {
								VM Metrics Agent
							}
							@accordion.Content() {
								<p class="text-sm text-muted-foreground mb-3">
									Collect CPU, memory, disk, network and load metrics from your servers.
								</p>
								<div class="rounded border bg-muted/50 p-3 relative group">
									<button class="absolute top-2 right-2 text-xs text-muted-foreground border rounded px-2 py-0.5 hover:text-foreground opacity-0 group-hover:opacity-100 transition-opacity copy-btn" data-copy="install">
										copy
									</button>
									<pre class="font-mono text-sm overflow-x-auto"><code id="agent-install-cmd">loading...</code></pre>
								</div>
								<div class="mt-4 space-y-2">
									@setupEnvRow("OPENTRACE_SERVER_URL", "URL of your OpenTrace server (required)")
									@setupEnvRow("OPENTRACE_API_KEY", "API key for authentication")
									@setupEnvRow("OPENTRACE_AGENT_INTERVAL", "Collection interval (default: 30s)")
								</div>
							}
						}
						@accordion.Item() {
							@accordion.Trigger() {
								Browser Error Tracking
							}
							@accordion.Content() {
								<p class="text-sm text-muted-foreground mb-3">
									Capture JavaScript errors and forward them to OpenTrace.
								</p>
								<div class="rounded border bg-muted/50 p-3 relative group">
									<button class="absolute top-2 right-2 text-xs text-muted-foreground border rounded px-2 py-0.5 hover:text-foreground opacity-0 group-hover:opacity-100 transition-opacity copy-btn" data-copy="js-snippet">
										copy
									</button>
									<pre class="font-mono text-sm overflow-x-auto"><code id="js-snippet">loading...</code></pre>
								</div>
							}
						}
						@accordion.Item() {
							@accordion.Trigger() {
								Environment Variables
							}
							@accordion.Content() {
								<div class="space-y-2">
									@setupEnvRow("OPENTRACE_LISTEN_ADDR", "HTTP listen address (default: 127.0.0.1:8080)")
									@setupEnvRow("OPENTRACE_DATA_DIR", "SQLite directory (default: ~/.opentrace)")
									@setupEnvRow("OPENTRACE_API_KEY", "API key for log ingestion")
									@setupEnvRow("OPENTRACE_CORS_ORIGINS", "Allowed CORS origins, comma-separated")
									@setupEnvRow("OPENTRACE_MCP_TOKEN", "MCP SSE transport auth token")
									@setupEnvRow("OPENTRACE_MCP_NAME", "Custom MCP server name")
									@setupEnvRow("OPENTRACE_TLS_CERT", "Path to TLS certificate")
									@setupEnvRow("OPENTRACE_TLS_KEY", "Path to TLS private key")
									@setupEnvRow("OPENTRACE_TRUSTED_PROXIES", "Reverse proxy IPs, comma-separated")
									@setupEnvRow("OPENTRACE_DEV", "Enable dev mode (default: false)")
								</div>
							}
						}
					}
				}
			}
		</div>
		@setupScript(setup.APIKey)
	}
}

templ setupStep(num, title string) {
	<div class="flex gap-4 pb-6 border-b">
		<div class="flex-shrink-0 w-6 h-6 rounded-full border flex items-center justify-center text-xs text-muted-foreground">
			{ num }
		</div>
		<div class="flex-1 min-w-0">
			<h3 class="text-sm font-semibold mb-3">{ title }</h3>
			{ children... }
		</div>
	</div>
}

templ setupEnvRow(envVar, description string) {
	<div class="flex gap-3 text-xs py-1">
		<code class="text-foreground font-semibold shrink-0 min-w-[220px]">{ envVar }</code>
		<span class="text-muted-foreground">{ description }</span>
	</div>
}

templ setupScript(apiKey string) {
	<script>
	(function() {
		var baseURL = window.location.protocol + '//' + window.location.host;
		var apiKey = document.currentScript ? null : null;
		try { apiKey = JSON.parse('"' + document.querySelector('[data-api-key]')?.dataset.apiKey + '"'); } catch(e) {}

		// Dynamic content
		var installEl = document.getElementById('agent-install-cmd');
		var installURL = baseURL + '/api/agent/install.sh';
		if (installEl) installEl.textContent = 'curl -fsSL ' + installURL + ' | sudo bash';

		var jsSnippetEl = document.getElementById('js-snippet');
		if (jsSnippetEl) {
			jsSnippetEl.textContent =
				'<script src="' + baseURL + '/static/opentrace.min.js"><\/script>\n' +
				'<script>\n  OpenTrace.init({\n    endpoint: "' + baseURL + '/api/logs",\n    service: "my-app-frontend",\n  });\n<\/script>';
		}

		// Client picker
		var clientConfigs = {
			claude:   '{\n  "mcpServers": {\n    "opentrace": {\n      "command": "opentrace",\n      "args": ["mcp"]\n    }\n  }\n}',
			cursor:   '{\n  "mcpServers": {\n    "opentrace": {\n      "command": "opentrace",\n      "args": ["mcp"]\n    }\n  }\n}',
			windsurf: '{\n  "mcpServers": {\n    "opentrace": {\n      "command": "opentrace",\n      "args": ["mcp"]\n    }\n  }\n}',
			other:    '{\n  "name": "opentrace",\n  "transport": "stdio",\n  "command": "opentrace",\n  "args": ["mcp"]\n}'
		};
		var clientHints = {
			claude:   'Add to <code class="bg-muted px-1 rounded">.mcp.json</code> or <code class="bg-muted px-1 rounded">~/.claude.json</code>',
			cursor:   'Add to <code class="bg-muted px-1 rounded">.cursor/mcp.json</code> in your project root',
			windsurf: 'Add to <code class="bg-muted px-1 rounded">~/.codeium/windsurf/mcp_config.json</code>',
			other:    'Use this generic stdio config with any MCP client'
		};
		document.querySelectorAll('.setup-client-btn').forEach(function(btn) {
			btn.addEventListener('click', function() {
				document.querySelectorAll('.setup-client-btn').forEach(b => b.classList.remove('active', 'bg-muted/50'));
				btn.classList.add('active', 'bg-muted/50');
				var client = btn.dataset.client;
				document.getElementById('mcp-config').textContent = clientConfigs[client];
				document.getElementById('client-hint').innerHTML = clientHints[client];
			});
		});

		// Copy buttons
		document.querySelectorAll('.copy-btn').forEach(function(btn) {
			btn.addEventListener('click', function() {
				var code = btn.parentElement.querySelector('code');
				if (code) {
					navigator.clipboard.writeText(code.textContent).then(function() {
						btn.textContent = 'copied!';
						setTimeout(function() { btn.textContent = 'copy'; }, 2000);
					});
				}
			});
		});
	})();
	</script>
}
