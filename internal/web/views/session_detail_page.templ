package webviews

import (
	"fmt"
	"github.com/adham90/opentrace/components/badge"
	"github.com/adham90/opentrace/components/breadcrumb"
	"github.com/adham90/opentrace/components/card"
	"github.com/adham90/opentrace/internal/store"
	"github.com/adham90/opentrace/internal/views"
)

// SessionDetailData holds data for the session detail page.
type SessionDetailData struct {
	Session  *store.InvestigationSession
	Events   []store.MCPActivityEvent
}

templ SessionDetailPage(data views.LayoutData, detail SessionDetailData) {
	@views.Layout(data) {
		<div class="space-y-6">
			// Breadcrumb
			@breadcrumb.Breadcrumb() {
				@breadcrumb.List() {
					@breadcrumb.Item() {
						@breadcrumb.Link(breadcrumb.LinkProps{Href: "/sessions"}) {
							Sessions
						}
					}
					@breadcrumb.Separator()
					@breadcrumb.Item(breadcrumb.ItemProps{Current: true}) {
						{ truncateID(detail.Session.ID, 8) }
					}
				}
			}
			if detail.Session != nil {
				// Hero header
				@card.Card() {
					@card.Content(card.ContentProps{Class: "p-5"}) {
						<div class="flex items-center justify-between mb-3">
							<div class="flex items-center gap-3">
								<h1 class="text-xl font-bold">
									Session
									<span class="text-muted-foreground">{ truncateID(detail.Session.ID, 8) }</span>
								</h1>
								@sessionStatusBadge(string(detail.Session.Status))
							</div>
						</div>
						if detail.Session.Summary != "" {
							<div class="text-sm bg-muted/50 rounded p-3 mb-4 border">
								{ detail.Session.Summary }
							</div>
						}
						// Metadata
						<div class="flex flex-wrap gap-x-5 gap-y-1 text-xs">
							@sessionMeta("user", detail.Session.UserEmail)
							if detail.Session.ClientName != "" {
								@sessionMeta("client", fmt.Sprintf("%s%s", detail.Session.ClientName, versionSuffix(detail.Session.ClientVersion)))
							}
							if detail.Session.PrimaryService != "" {
								@sessionMeta("service", detail.Session.PrimaryService)
							}
							if detail.Session.Intent != "" {
								@sessionMeta("intent", detail.Session.Intent)
							}
							@sessionMeta("steps", fmt.Sprintf("%d", detail.Session.TotalSteps))
							if detail.Session.TotalErrors > 0 {
								<span>
									<span class="text-muted-foreground">errors: </span>
									<span class="text-destructive">{ fmt.Sprintf("%d", detail.Session.TotalErrors) }</span>
								</span>
							}
							if detail.Session.DurationSeconds > 0 {
								@sessionMeta("duration", fmtDuration(detail.Session.DurationSeconds))
							}
							@sessionMeta("started", detail.Session.StartedAt.Format("Jan 02 15:04 UTC"))
							if detail.Session.EndedAt != nil {
								@sessionMeta("ended", detail.Session.EndedAt.Format("Jan 02 15:04 UTC"))
							}
						</div>
					}
				}
				// Outcome details
				if detail.Session.RootCause != "" || detail.Session.FixDescription != "" {
					@card.Card() {
						@card.Header() {
							@card.Title() {
								Outcome
							}
						}
						@card.Content() {
							<dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-2 text-sm">
								if detail.Session.RootCause != "" {
									<dt class="text-muted-foreground whitespace-nowrap">root cause</dt>
									<dd>{ detail.Session.RootCause }</dd>
								}
								if detail.Session.FixDescription != "" {
									<dt class="text-muted-foreground whitespace-nowrap">fix</dt>
									<dd>{ detail.Session.FixDescription }</dd>
								}
								if detail.Session.RecurrenceGroup != nil {
									<dt class="text-muted-foreground whitespace-nowrap">recurrence</dt>
									<dd>
										<code class="text-xs">{ *detail.Session.RecurrenceGroup }</code>
										{ fmt.Sprintf(" (%dx)", detail.Session.RecurrenceCount) }
									</dd>
								}
								if detail.Session.PreviousSessionID != nil {
									<dt class="text-muted-foreground whitespace-nowrap">previous</dt>
									<dd>
										<a
											href={ templ.SafeURL(fmt.Sprintf("/sessions/%s", *detail.Session.PreviousSessionID)) }
											class="text-blue-400 hover:underline font-mono text-xs"
										>
											{ truncateID(*detail.Session.PreviousSessionID, 8) }
										</a>
									</dd>
								}
							</dl>
						}
					}
				}
				// Linked artifacts
				if hasArtifacts(detail.Session) {
					@card.Card() {
						@card.Header() {
							@card.Title() {
								Linked Artifacts
							}
						}
						@card.Content() {
							<div class="space-y-2">
								if detail.Session.TriggeredByWatcherID != nil {
									@artifactRow("triggered by", []artifactLink{{Label: "watcher " + truncateID(*detail.Session.TriggeredByWatcherID, 8), Href: "/watchers/" + *detail.Session.TriggeredByWatcherID}})
								}
								if len(detail.Session.CreatedWatcherIDs) > 0 {
									@artifactRow("watchers created", watcherLinks(detail.Session.CreatedWatcherIDs))
								}
								if len(detail.Session.ResolvedErrorGroupIDs) > 0 {
									@artifactRow("errors resolved", errorLinks(detail.Session.ResolvedErrorGroupIDs))
								}
								if len(detail.Session.CreatedHealthcheckIDs) > 0 {
									@artifactRowPlain("healthchecks created", detail.Session.CreatedHealthcheckIDs)
								}
								if len(detail.Session.TraceIDs) > 0 {
									@artifactRowPlain("traces", detail.Session.TraceIDs)
								}
								if len(detail.Session.RunbooksExecuted) > 0 {
									@artifactRowPlain("runbooks", detail.Session.RunbooksExecuted)
								}
								if len(detail.Session.FilesModified) > 0 {
									@artifactRowPlain("files modified", detail.Session.FilesModified)
								}
								if len(detail.Session.FilesRead) > 0 {
									@artifactRowPlain("files read", detail.Session.FilesRead)
								}
							</div>
						}
					}
				}
				// Investigation impact
				if len(detail.Session.PreInvestigationSnapshot) > 0 || len(detail.Session.PostInvestigationSnapshot) > 0 {
					@card.Card() {
						@card.Header() {
							@card.Title() {
								Investigation Impact
							}
						}
						@card.Content() {
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								if len(detail.Session.PreInvestigationSnapshot) > 0 {
									@snapshotBlock("Before", detail.Session.PreInvestigationSnapshot)
								}
								if len(detail.Session.PostInvestigationSnapshot) > 0 {
									@snapshotBlock("After", detail.Session.PostInvestigationSnapshot)
								}
							</div>
						}
					}
				}
			}
			// Activity log
			if len(detail.Events) > 0 {
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Activity Log
							<span class="text-muted-foreground font-normal text-sm ml-2">
								{ fmt.Sprintf("(%d events)", len(detail.Events)) }
							</span>
						}
					}
					@card.Content(card.ContentProps{Class: "p-0"}) {
						<div class="divide-y" id="activity-list">
							for i, ev := range detail.Events {
								@activityRow(i, ev, detail.Session.StartedAt)
							}
						</div>
					}
				}
			}
		</div>
		@sessionDetailScript()
	}
}

templ sessionMeta(label, value string) {
	<span>
		<span class="text-muted-foreground">{ label }: </span>
		<span class="font-mono">{ value }</span>
	</span>
}

templ activityRow(idx int, ev store.MCPActivityEvent, sessionStart interface{}) {
	<div class={ "group", templ.KV("bg-destructive/5", ev.IsError) }>
		<div
			class="flex items-center gap-2 px-4 py-2.5 cursor-pointer hover:bg-muted/50 transition-colors"
			data-toggle-detail={ fmt.Sprintf("detail-%d", idx) }
		>
			<span class="text-xs font-mono text-muted-foreground w-5 text-right shrink-0">
				{ fmt.Sprintf("%d", idx+1) }
			</span>
			<code class={ "text-sm font-mono", templ.KV("text-blue-400", !ev.IsError), templ.KV("text-destructive", ev.IsError) }>
				{ ev.ToolName }
			</code>
			if ev.IsError {
				@badge.Badge(badge.Props{Variant: badge.VariantDestructive, Class: "text-[9px] ml-1"}) {
					error
				}
			}
			<span class="flex-1"></span>
			if ev.DurationMs != nil {
				<span class="text-xs font-mono text-muted-foreground">
					{ fmt.Sprintf("%dms", *ev.DurationMs) }
				</span>
			}
			<span class="text-xs text-muted-foreground transition-transform duration-150" data-chevron>
				&#9654;
			</span>
		</div>
		<div class="hidden bg-muted/30 border-t px-4 py-3 space-y-3" id={ fmt.Sprintf("detail-%d", idx) }>
			if ev.Arguments != "" {
				<div>
					<div class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider mb-1">Arguments</div>
					<pre class="text-xs font-mono bg-background border rounded p-3 overflow-x-auto max-h-48 whitespace-pre-wrap break-all">{ ev.Arguments }</pre>
				</div>
			}
			if ev.ResultPreview != "" {
				<div>
					<div class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider mb-1">Result</div>
					<pre class={ "text-xs font-mono bg-background border rounded p-3 overflow-x-auto max-h-48 whitespace-pre-wrap break-all", templ.KV("text-destructive border-destructive/30", ev.IsError) }>{ ev.ResultPreview }</pre>
				</div>
			}
			if ev.Arguments == "" && ev.ResultPreview == "" {
				<span class="text-sm text-muted-foreground">No details available</span>
			}
		</div>
	</div>
}

type artifactLink struct {
	Label string
	Href  string
}

templ artifactRow(label string, links []artifactLink) {
	<div class="flex items-baseline gap-3 text-sm">
		<span class="text-xs text-muted-foreground font-mono min-w-[140px] shrink-0">{ label }</span>
		<div class="flex flex-wrap gap-1">
			for _, link := range links {
				<a
					href={ templ.SafeURL(link.Href) }
					class="font-mono text-xs border rounded px-2 py-0.5 text-blue-400 hover:border-blue-400 transition-colors no-underline"
				>
					{ link.Label }
				</a>
			}
		</div>
	</div>
}

templ artifactRowPlain(label string, items []string) {
	<div class="flex items-baseline gap-3 text-sm">
		<span class="text-xs text-muted-foreground font-mono min-w-[140px] shrink-0">{ label }</span>
		<div class="flex flex-wrap gap-1">
			for _, item := range items {
				<code class="text-xs border rounded px-2 py-0.5">{ truncateID(item, 12) }</code>
			}
		</div>
	</div>
}

templ snapshotBlock(label string, snapshot map[string]float64) {
	<div class="bg-muted/50 border rounded p-3">
		<div class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider mb-2">{ label }</div>
		<dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
			for k, v := range snapshot {
				<dt class="text-muted-foreground">{ k }</dt>
				<dd class="font-mono">{ fmt.Sprintf("%.1f", v) }</dd>
			}
		</dl>
	</div>
}

templ sessionDetailScript() {
	<script>
	(function() {
		document.querySelectorAll('[data-toggle-detail]').forEach(function(row) {
			row.addEventListener('click', function() {
				var detailId = row.dataset.toggleDetail;
				var detail = document.getElementById(detailId);
				if (!detail) return;
				var isOpen = !detail.classList.contains('hidden');
				// Close all
				document.querySelectorAll('#activity-list > div > div[id]').forEach(function(d) { d.classList.add('hidden'); });
				document.querySelectorAll('[data-chevron]').forEach(function(c) { c.style.transform = ''; });
				if (!isOpen) {
					detail.classList.remove('hidden');
					var chevron = row.querySelector('[data-chevron]');
					if (chevron) chevron.style.transform = 'rotate(90deg)';
				}
			});
		});
	})();
	</script>
}

func versionSuffix(v string) string {
	if v == "" {
		return ""
	}
	return " v" + v
}

func hasArtifacts(s *store.InvestigationSession) bool {
	if s == nil {
		return false
	}
	return s.TriggeredByWatcherID != nil ||
		s.TriggeredByHealthcheckID != nil ||
		len(s.CreatedWatcherIDs) > 0 ||
		len(s.ResolvedErrorGroupIDs) > 0 ||
		len(s.CreatedHealthcheckIDs) > 0 ||
		len(s.TraceIDs) > 0 ||
		len(s.RunbooksExecuted) > 0 ||
		len(s.FilesModified) > 0 ||
		len(s.FilesRead) > 0 ||
		s.CorrelatedDeploy != ""
}

func watcherLinks(ids []string) []artifactLink {
	links := make([]artifactLink, len(ids))
	for i, id := range ids {
		links[i] = artifactLink{Label: truncateID(id, 8), Href: "/watchers/" + id}
	}
	return links
}

func errorLinks(ids []string) []artifactLink {
	links := make([]artifactLink, len(ids))
	for i, id := range ids {
		links[i] = artifactLink{Label: truncateID(id, 12), Href: "/errors/" + id}
	}
	return links
}
