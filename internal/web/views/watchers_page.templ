package webviews

import (
	"fmt"
	"github.com/adham90/opentrace/components/badge"
	"github.com/adham90/opentrace/components/button"
	"github.com/adham90/opentrace/components/card"
	"github.com/adham90/opentrace/components/table"
	"github.com/adham90/opentrace/internal/store"
	"github.com/adham90/opentrace/internal/views"
)

templ WatchersPage(data views.LayoutData, watches []store.Watch, watchAlerts []store.WatchAlert, pendingCount int) {
	@views.Layout(data) {
		<div class="space-y-6">
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-bold tracking-tight">
					Watchers
					if pendingCount > 0 {
						<span class="text-muted-foreground text-base font-normal ml-2">
							{ fmt.Sprintf("%d pending alerts", pendingCount) }
						</span>
					}
				</h1>
			</div>
			if len(watches) > 0 {
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Watches
						}
					}
					@card.Content(card.ContentProps{Class: "p-0"}) {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head(table.HeadProps{Class: "w-3"}) {
									}
									@table.Head() {
										Metric
									}
									@table.Head() {
										Service
									}
									@table.Head() {
										Threshold
									}
									@table.Head() {
										Current
									}
									@table.Head() {
										Interval
									}
									@table.Head(table.HeadProps{Class: "text-right"}) {
										Breaches
									}
									@table.Head() {
										Last Checked
									}
								}
							}
							@table.Body(table.BodyProps{ID: "watches-table-body"}) {
								for _, w := range watches {
									@table.Row(table.RowProps{
										Class:      "cursor-pointer",
										Attributes: templ.Attributes{"data-watch-id": w.ID},
									}) {
										@table.Cell() {
											<span class={ "inline-block w-2 h-2 rounded-full",
												templ.KV("bg-green-500", string(w.Status) == "active"),
												templ.KV("bg-red-500", string(w.Status) == "triggered"),
												templ.KV("bg-muted-foreground", string(w.Status) != "active" && string(w.Status) != "triggered"),
											}></span>
										}
										@table.Cell(table.CellProps{Class: "font-medium"}) {
											{ string(w.Metric) }
										}
										@table.Cell() {
											if w.Service != "" {
												@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
													{ w.Service }
												}
											}
										}
										@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
											{ fmt.Sprintf("%s %g", string(w.Operator), w.Threshold) }
										}
										@table.Cell() {
											if w.CurrentValue != nil {
												{ fmt.Sprintf("%g", *w.CurrentValue) }
											} else {
												<span class="text-muted-foreground">-</span>
											}
										}
										@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
											{ w.CheckInterval }
										}
										@table.Cell(table.CellProps{Class: "text-right font-semibold"}) {
											{ fmt.Sprintf("%d", w.ConsecutiveBreaches) }
										}
										@table.Cell(table.CellProps{Class: "text-muted-foreground text-xs"}) {
											if w.LastCheckedAt != nil {
												{ views.TimeAgo(*w.LastCheckedAt) }
											} else {
												-
											}
										}
									}
								}
							}
						}
					}
				}
			} else {
				@card.Card() {
					@card.Content(card.ContentProps{Class: "py-12 text-center"}) {
						<p class="text-lg font-medium text-muted-foreground">No watches configured</p>
						<p class="text-sm text-muted-foreground mt-1">Watches are created by the AI agent during investigations to monitor metrics.</p>
					}
				}
			}
			if len(watchAlerts) > 0 {
				@card.Card() {
					@card.Header() {
						@card.Title() {
							Alerts
						}
					}
					@card.Content(card.ContentProps{Class: "p-0"}) {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head(table.HeadProps{Class: "w-3"}) {
									}
									@table.Head() {
										Summary
									}
									@table.Head() {
										Metric
									}
									@table.Head() {
										Value
									}
									@table.Head() {
										Threshold
									}
									@table.Head() {
										Status
									}
									@table.Head() {
										Time
									}
									@table.Head() {
									}
								}
							}
							@table.Body() {
								for _, a := range watchAlerts {
									@table.Row() {
										@table.Cell() {
											<span class={ "inline-block w-2 h-2 rounded-full",
												templ.KV("bg-yellow-500", a.Status == "pending"),
												templ.KV("bg-muted-foreground", a.Status == "dismissed"),
												templ.KV("bg-green-500", a.Status != "pending" && a.Status != "dismissed"),
											}></span>
										}
										@table.Cell(table.CellProps{Class: "font-medium max-w-[300px] truncate"}) {
											{ a.Summary }
										}
										@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
											{ a.TriggerMetric }
										}
										@table.Cell(table.CellProps{Class: "font-semibold"}) {
											{ fmt.Sprintf("%g", a.TriggerValue) }
										}
										@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
											{ fmt.Sprintf("%g", a.ThresholdValue) }
										}
										@table.Cell() {
											if a.Status == "pending" {
												@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
													{ a.Status }
												}
											} else if a.Status == "dismissed" {
												@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
													{ a.Status }
												}
											} else {
												@badge.Badge(badge.Props{Variant: badge.VariantDefault}) {
													{ a.Status }
												}
											}
										}
										@table.Cell(table.CellProps{Class: "text-muted-foreground text-xs"}) {
											{ views.TimeAgo(a.CreatedAt) }
										}
										@table.Cell() {
											if a.Status == "pending" {
												@button.Button(button.Props{
													Size:       button.SizeSm,
													Variant:    button.VariantOutline,
													Attributes: templ.Attributes{"data-dismiss-id": a.ID},
												}) {
													Dismiss
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		</div>
		@watchersScript()
	}
}

templ watchersScript() {
	<script>
		(function() {
			var tbody = document.getElementById('watches-table-body');
			if (tbody) {
				tbody.addEventListener('click', function(e) {
					var row = e.target.closest('tr[data-watch-id]');
					if (row && row.dataset.watchId) {
						window.location.href = '/watchers/' + encodeURIComponent(row.dataset.watchId);
					}
				});
			}
			document.addEventListener('click', function(e) {
				var btn = e.target.closest('[data-dismiss-id]');
				if (!btn) return;
				var id = btn.getAttribute('data-dismiss-id');
				fetch('/api/watches/alerts/' + id + '/dismiss', {
					method: 'POST',
					headers: {'Content-Type': 'application/json'},
					body: JSON.stringify({reason: 'dismissed from UI'})
				}).then(function(r) {
					if (r.ok) window.location.reload();
				});
			});
		})();
	</script>
}
