package webviews

import (
	"github.com/adham90/opentrace/components/badge"
	"github.com/adham90/opentrace/components/button"
	"github.com/adham90/opentrace/components/card"
	"github.com/adham90/opentrace/components/table"
	"github.com/adham90/opentrace/internal/store"
	"github.com/adham90/opentrace/internal/views"
)

templ ConnectorsPage(data views.LayoutData, dataSources []store.DataSource) {
	@views.Layout(data) {
		<div class="space-y-6">
			<h1 class="text-2xl font-bold tracking-tight">Connectors</h1>
			if len(dataSources) > 0 {
				@card.Card() {
					@card.Content(card.ContentProps{Class: "p-0"}) {
						@table.Table(table.Props{Attributes: templ.Attributes{"aria-label": "Connectors"}}) {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										Name
									}
									@table.Head() {
										Type
									}
									@table.Head() {
										Status
									}
									@table.Head() {
										Last Tested
									}
									if data.IsAdmin {
										@table.Head() {
											Actions
										}
									}
								}
							}
							@table.Body() {
								for _, ds := range dataSources {
									@table.Row(table.RowProps{
										Class:      "cursor-pointer conn-row",
										Attributes: templ.Attributes{"data-id": ds.ID.String()},
									}) {
										@table.Cell(table.CellProps{Class: "font-mono font-medium"}) {
											{ ds.Name }
										}
										@table.Cell() {
											@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
												{ string(ds.Type) }
											}
										}
										@table.Cell() {
											@connectorStatusBadge(string(ds.Status))
										}
										@table.Cell(table.CellProps{Class: "text-sm text-muted-foreground"}) {
											if ds.LastTestedAt != nil {
												{ ds.LastTestedAt.Format("Jan 02, 15:04") }
											} else {
												<span class="text-muted-foreground">never</span>
											}
										}
										if data.IsAdmin {
											@table.Cell(table.CellProps{Class: "actions-cell"}) {
												<div class="flex gap-1.5" onclick="event.stopPropagation()">
													@button.Button(button.Props{
														Size:       button.SizeSm,
														Variant:    button.VariantOutline,
														Class:      "btn-test",
														ID:         "test-btn-" + ds.ID.String(),
														Attributes: templ.Attributes{"data-id": ds.ID.String()},
													}) {
														Test
													}
													@button.Button(button.Props{
														Size:       button.SizeSm,
														Variant:    button.VariantDestructive,
														Class:      "btn-delete-conn",
														Attributes: templ.Attributes{"data-id": ds.ID.String(), "data-name": ds.Name},
													}) {
														Delete
													}
												</div>
											}
										}
									}
									<tr class="conn-detail-row" id={ "detail-" + ds.ID.String() } style="display:none">
										if data.IsAdmin {
											<td colspan="5" class="p-0">
												<div class="conn-detail p-3 bg-muted/50 border-t text-sm font-mono" data-id={ ds.ID.String() }></div>
											</td>
										} else {
											<td colspan="4" class="p-0">
												<div class="conn-detail p-3 bg-muted/50 border-t text-sm font-mono" data-id={ ds.ID.String() }></div>
											</td>
										}
									</tr>
								}
							}
						}
					}
				}
			} else {
				@card.Card() {
					@card.Content(card.ContentProps{Class: "py-12 text-center"}) {
						<p class="text-lg font-medium text-muted-foreground">No connectors configured</p>
						<p class="text-sm text-muted-foreground mt-1">Connectors are added via the MCP server or API.</p>
					}
				}
			}
		</div>
		@connectorsScript(data.IsAdmin)
	}
}

templ connectorStatusBadge(status string) {
	if status == "connected" {
		<span class="inline-flex items-center gap-1.5 text-xs">
			<span class="inline-block w-2 h-2 rounded-full bg-green-500"></span>
			{ status }
		</span>
	} else if status == "error" {
		<span class="inline-flex items-center gap-1.5 text-xs">
			<span class="inline-block w-2 h-2 rounded-full bg-red-500"></span>
			{ status }
		</span>
	} else {
		<span class="inline-flex items-center gap-1.5 text-xs">
			<span class="inline-block w-2 h-2 rounded-full bg-muted-foreground"></span>
			{ status }
		</span>
	}
}

templ connectorsScript(isAdmin bool) {
	<script>
		function escH(s) { var d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }

		document.querySelectorAll('.conn-row').forEach(function(row) {
			row.addEventListener('click', function() {
				var id = row.getAttribute('data-id');
				var detailRow = document.getElementById('detail-' + id);
				if (!detailRow) return;
				var expanding = detailRow.style.display === 'none';
				document.querySelectorAll('.conn-detail-row').forEach(function(r) { r.style.display = 'none'; });
				if (expanding) {
					detailRow.style.display = '';
					var detail = detailRow.querySelector('.conn-detail');
					if (!detail.getAttribute('data-loaded')) {
						detail.innerHTML = '<span class="text-muted-foreground">Loading...</span>';
						fetch('/api/connectors/' + id).then(function(r) {
							if (!r.ok) throw new Error('HTTP ' + r.status);
							return r.json();
						}).then(function(data) {
							detail.setAttribute('data-loaded', '1');
							renderDetail(detail, data);
						}).catch(function(err) {
							detail.innerHTML = '<span class="text-destructive">' + escH(err.message) + '</span>';
						});
					}
				}
			});
		});

		function renderDetail(el, data) {
			var html = '';
			html += dRow('id', data.id);
			html += dRow('type', data.type);
			html += dRow('status', data.status);
			if (data.status_message) html += dRow('message', data.status_message);
			html += dRow('created', data.created_at);
			html += dRow('updated', data.updated_at);
			if (data.last_tested_at) html += dRow('last_tested', data.last_tested_at);
			if (data.config && Object.keys(data.config).length > 0) {
				html += '<div class="text-xs text-muted-foreground uppercase tracking-wider mt-2 pt-2 border-t mb-1">Config</div>';
				Object.keys(data.config).sort().forEach(function(k) {
					var v = data.config[k];
					if (k === 'connection_string' || k === 'dsn') { html += dRow(k, maskDSN(String(v))); }
					else if (typeof v === 'object') { html += dRow(k, JSON.stringify(v)); }
					else { html += dRow(k, String(v)); }
				});
			}
			el.innerHTML = html;
		}

		function dRow(key, val) {
			return '<div class="flex gap-4 py-0.5 text-xs"><span class="text-muted-foreground min-w-[120px]">' + escH(key) + '</span><span class="break-all">' + escH(String(val)) + '</span></div>';
		}

		function maskDSN(dsn) { return dsn.replace(/:\/\/([^:]+):([^@]+)@/, '://$1:****@'); }
	</script>
	if isAdmin {
		<script>
			function testConnector(id) {
				var btn = document.getElementById('test-btn-' + id);
				if (!btn) return;
				btn.disabled = true; btn.textContent = 'Testing...';
				fetch('/api/connectors/' + id + '/test', {method: 'POST'}).then(function(r) {
					if (!r.ok) return r.json().then(function(d) { throw new Error(d.error || 'test failed'); });
					return r.json();
				}).then(function() {
					location.reload();
				}).catch(function(e) {
					btn.disabled = false; btn.textContent = 'Test';
					alert('Test failed: ' + e.message);
				});
			}

			function deleteConnector(id, name) {
				if (!confirm('Delete connector "' + name + '"? This cannot be undone.')) return;
				fetch('/api/connectors/' + id, {method: 'DELETE'}).then(function(r) {
					if (!r.ok) return r.json().then(function(d) { throw new Error(d.error || 'delete failed'); });
					location.reload();
				}).catch(function(e) {
					alert('Error: ' + e.message);
				});
			}

			document.querySelectorAll('.btn-test').forEach(function(btn) {
				btn.addEventListener('click', function() { testConnector(btn.getAttribute('data-id')); });
			});
			document.querySelectorAll('.btn-delete-conn').forEach(function(btn) {
				btn.addEventListener('click', function() { deleteConnector(btn.getAttribute('data-id'), btn.getAttribute('data-name')); });
			});
		</script>
	}
}
