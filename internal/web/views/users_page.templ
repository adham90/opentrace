package webviews

import (
	"fmt"
	"github.com/adham90/opentrace/components/badge"
	"github.com/adham90/opentrace/components/button"
	"github.com/adham90/opentrace/components/card"
	"github.com/adham90/opentrace/components/table"
	"github.com/adham90/opentrace/internal/store"
	"github.com/adham90/opentrace/internal/views"
)

templ UsersPage(data views.LayoutData, users []store.User, isAdmin bool) {
	@views.Layout(data) {
		<div class="space-y-6">
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-bold tracking-tight">Users</h1>
				if isAdmin {
					@button.Button(button.Props{Href: "/register", Size: button.SizeSm}) {
						Invite User
					}
				}
			</div>
			if len(users) > 0 {
				@card.Card() {
					@card.Content(card.ContentProps{Class: "p-0"}) {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										Email
									}
									@table.Head() {
										Display Name
									}
									@table.Head() {
										Role
									}
									@table.Head() {
										MCP
									}
									@table.Head() {
										Active
									}
									if isAdmin {
										@table.Head() {
											Actions
										}
									}
								}
							}
							@table.Body() {
								for _, u := range users {
									@userRow(u, isAdmin)
								}
							}
						}
					}
				}
			} else {
				@card.Card() {
					@card.Content(card.ContentProps{Class: "py-12 text-center"}) {
						<p class="text-lg font-medium text-muted-foreground">No users registered</p>
					}
				}
			}
		</div>
		if isAdmin {
			@usersScript()
		}
	}
}

templ userRow(u store.User, isAdmin bool) {
	@table.Row(table.RowProps{
		Attributes: templ.Attributes{"id": fmt.Sprintf("user-row-%s", u.ID)},
	}) {
		@table.Cell() {
			{ u.Email }
		}
		@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
			{ u.DisplayName }
		}
		@table.Cell() {
			if isAdmin {
				<select
					class="bg-transparent border rounded px-2 py-0.5 text-xs font-mono role-select"
					data-user-id={ u.ID }
					aria-label={ fmt.Sprintf("Role for %s", u.Email) }
				>
					<option value="admin" selected?={ string(u.Role) == "admin" }>admin</option>
					<option value="member" selected?={ string(u.Role) == "member" }>member</option>
				</select>
			} else {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					{ string(u.Role) }
				}
			}
		}
		@table.Cell() {
			if u.MCPEnabled {
				@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "text-[10px]"}) {
					on
				}
			} else {
				@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-[10px] text-muted-foreground"}) {
					off
				}
			}
		}
		@table.Cell() {
			if u.IsActive {
				<span class="inline-block w-2 h-2 rounded-full bg-green-500"></span>
			} else {
				<span class="inline-block w-2 h-2 rounded-full bg-muted-foreground"></span>
			}
		}
		if isAdmin {
			@table.Cell() {
				<div class="flex items-center gap-2">
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeSm,
						Attributes: templ.Attributes{"data-toggle-active": u.ID, "data-active": fmt.Sprintf("%t", u.IsActive)},
					}) {
						if u.IsActive {
							Deactivate
						} else {
							Activate
						}
					}
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeSm,
						Attributes: templ.Attributes{"data-regen-token": u.ID},
					}) {
						Regen Token
					}
					@button.Button(button.Props{
						Variant:    button.VariantDestructive,
						Size:       button.SizeSm,
						Attributes: templ.Attributes{"data-delete-user": u.ID, "data-email": u.Email},
					}) {
						Delete
					}
				</div>
			}
		}
	}
}

templ usersScript() {
	<script>
	(function() {
		function userApiCall(url, body) {
			return fetch(url, {
				method: 'POST',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify(body)
			}).then(r => { if (!r.ok) throw new Error('request failed'); return r.json(); });
		}

		// Role change
		document.querySelectorAll('.role-select').forEach(sel => {
			sel.addEventListener('change', () => {
				userApiCall('/api/users/' + sel.dataset.userId + '/role', {role: sel.value})
					.catch(() => location.reload());
			});
		});

		// Toggle active
		document.querySelectorAll('[data-toggle-active]').forEach(btn => {
			btn.addEventListener('click', () => {
				var active = btn.dataset.active === 'true';
				userApiCall('/api/users/' + btn.dataset.toggleActive + '/active', {active: !active})
					.then(() => location.reload())
					.catch(() => location.reload());
			});
		});

		// Regen token
		document.querySelectorAll('[data-regen-token]').forEach(btn => {
			btn.addEventListener('click', () => {
				if (!confirm('Regenerate MCP token? The old token will stop working.')) return;
				userApiCall('/api/users/' + btn.dataset.regenToken + '/mcp-token', {})
					.then(d => prompt('New MCP token (copy it now):', d.mcp_token));
			});
		});

		// Delete user
		document.querySelectorAll('[data-delete-user]').forEach(btn => {
			btn.addEventListener('click', () => {
				if (!confirm('Delete user ' + btn.dataset.email + '? This cannot be undone.')) return;
				fetch('/api/users/' + btn.dataset.deleteUser, {method: 'DELETE'})
					.then(r => { if (r.ok) location.reload(); });
			});
		});
	})();
	</script>
}
