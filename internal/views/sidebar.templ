package views

import "github.com/adham90/opentrace/components/icon"

templ Sidebar(data LayoutData) {
	<aside class="w-64 border-r border-border bg-card flex flex-col h-screen sticky top-0">
		<!-- Brand -->
		<div class="p-4 border-b border-border">
			<a href="/" class="text-lg font-bold text-foreground hover:text-primary transition-colors">
				opentrace
			</a>
		</div>
		<!-- Nav -->
		<nav class="flex-1 p-3 space-y-1 overflow-y-auto" aria-label="Main navigation">
			@navLink("/", "Dashboard", "dashboard", data.Nav) {
				@icon.LayoutDashboard(icon.Props{Class: "w-4 h-4"})
			}
			@navLink("/logs", "Logs", "logs", data.Nav) {
				@icon.FileText(icon.Props{Class: "w-4 h-4"})
			}
			@navLink("/errors", "Errors", "errors", data.Nav) {
				@icon.CircleAlert(icon.Props{Class: "w-4 h-4"})
			}
			@navLink("/watchers", "Watchers", "watchers", data.Nav) {
				@icon.Eye(icon.Props{Class: "w-4 h-4"})
			}
			@navLink("/health", "Health", "health", data.Nav) {
				@icon.Activity(icon.Props{Class: "w-4 h-4"})
			}
			@navLink("/connectors", "Connectors", "connectors", data.Nav) {
				@icon.Database(icon.Props{Class: "w-4 h-4"})
			}
			@navLink("/tools", "Tools", "tools", data.Nav) {
				@icon.Wrench(icon.Props{Class: "w-4 h-4"})
			}
			@navLink("/sessions", "Sessions", "sessions", data.Nav) {
				@icon.SquareTerminal(icon.Props{Class: "w-4 h-4"})
			}
			if data.IsAdmin {
				<div class="pt-4 mt-4 border-t border-border">
					<p class="px-3 mb-2 text-xs font-medium text-muted-foreground uppercase tracking-wider">Admin</p>
					@navLink("/settings", "Settings", "settings", data.Nav) {
						@icon.Settings(icon.Props{Class: "w-4 h-4"})
					}
					@navLink("/users", "Users", "users", data.Nav) {
						@icon.Users(icon.Props{Class: "w-4 h-4"})
					}
				</div>
			}
		</nav>
		<!-- User -->
		if data.User != nil {
			<div class="p-3 border-t border-border">
				<a href="/profile" class="flex items-center gap-2 px-3 py-2 text-sm rounded-md hover:bg-accent transition-colors">
					<div class="w-6 h-6 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-xs font-medium">
						{ string([]rune(data.User.DisplayName)[0:1]) }
					</div>
					<span class="text-foreground truncate">{ data.User.DisplayName }</span>
				</a>
			</div>
		}
	</aside>
}

templ navLink(href, label, key, activeNav string) {
	<a
		href={ templ.SafeURL(href) }
		class={ "flex items-center gap-3 px-3 py-2 text-sm rounded-md transition-colors",
			templ.KV("bg-accent text-accent-foreground font-medium", key == activeNav),
			templ.KV("text-muted-foreground hover:bg-accent hover:text-accent-foreground", key != activeNav) }
	>
		{ children... }
		{ label }
	</a>
}
