package views

templ Layout(data LayoutData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>
			if data.Title != "" {
				OpenTrace — { data.Title }
			} else {
				OpenTrace
			}
		</title>
		<link rel="stylesheet" href="/assets/css/output.css"/>
		<script src="/assets/js/htmx.min.js"></script>
		<script defer src="/assets/js/app.js"></script>
	</head>
	<body class="min-h-screen bg-background text-foreground" hx-boost="true">
		if data.User != nil {
			<div class="flex min-h-screen">
				@Sidebar(data)
				<main id="main-content" class="flex-1 p-6 overflow-auto">
					{ children... }
				</main>
			</div>
		} else {
			<main id="main-content" class="min-h-screen">
				{ children... }
			</main>
		}
	</body>
	</html>
}

templ LayoutMinimal(data LayoutData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>
			if data.Title != "" {
				OpenTrace — { data.Title }
			} else {
				OpenTrace
			}
		</title>
		<link rel="stylesheet" href="/assets/css/output.css"/>
		<script src="/assets/js/htmx.min.js"></script>
		<script defer src="/assets/js/app.js"></script>
	</head>
	<body class="min-h-screen bg-background text-foreground flex items-center justify-center">
		<main id="main-content" class="w-full max-w-md p-6">
			{ children... }
		</main>
	</body>
	</html>
}
