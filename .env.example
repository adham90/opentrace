# OpenTrace — copy to .env and adjust values
# Missing file is not an error; all vars have sensible defaults.

# ─── Core ────────────────────────────────────────────────────────────
# Directory for SQLite database (default: ~/.opentrace)
# OPENTRACE_DATA_DIR=~/.opentrace

# HTTP listen address (default: 127.0.0.1:8080)
OPENTRACE_LISTEN_ADDR=127.0.0.1:8080

# Enable dev mode: live template reload, /api/dev/hash endpoint (default: false)
# OPENTRACE_DEV=true

# ─── LLM Providers ──────────────────────────────────────────────────
# Which provider to use: ollama | anthropic | openai | gemini
OPENTRACE_LLM_PROVIDER=ollama

# Ollama (default provider — requires: ollama serve)
OPENTRACE_OLLAMA_URL=http://localhost:11434
OPENTRACE_OLLAMA_MODEL=llama3.2

# Anthropic
# OPENTRACE_ANTHROPIC_API_KEY=sk-ant-...
# OPENTRACE_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# OPENTRACE_ANTHROPIC_URL=https://api.anthropic.com

# OpenAI
# OPENTRACE_OPENAI_API_KEY=sk-...
# OPENTRACE_OPENAI_MODEL=gpt-4o
# OPENTRACE_OPENAI_URL=https://api.openai.com

# Google Gemini
# OPENTRACE_GEMINI_API_KEY=...
# OPENTRACE_GEMINI_MODEL=gemini-2.5-flash-preview-04-17
# OPENTRACE_GEMINI_URL=https://generativelanguage.googleapis.com

# ─── Guardrails ─────────────────────────────────────────────────────
# Max rows returned from connector queries (default: 500)
OPENTRACE_MAX_QUERY_ROWS=500

# Postgres statement timeout in milliseconds (default: 5000)
OPENTRACE_STATEMENT_TIMEOUT_MS=5000

# AI agent loop limits
OPENTRACE_MAX_AGENT_STEPS=12
OPENTRACE_MAX_TOOL_CALLS=8
OPENTRACE_MAX_OBSERVATION_BYTES=8192

# ─── Security ───────────────────────────────────────────────────────
# API key for log ingestion (POST /api/logs requires Authorization: Bearer <key>)
# If unset, also checked in DB via admin settings page.
# OPENTRACE_API_KEY=

# ─── MCP Server ─────────────────────────────────────────────────────
# Token for MCP SSE transport authentication (Bearer token)
# OPENTRACE_MCP_TOKEN=

# Custom MCP server name (shown in client UIs)
# OPENTRACE_MCP_NAME=

# ─── Data Retention ─────────────────────────────────────────────────
# Override metric retention independently of global setting (days, 0 = use global)
# OPENTRACE_METRIC_RETENTION_DAYS=30
