# OpenTrace — copy to .env and adjust values
# Missing file is not an error; all vars have sensible defaults.

# ─── Core ────────────────────────────────────────────────────────────
# Directory for SQLite database (default: ~/.opentrace)
# OPENTRACE_DATA_DIR=~/.opentrace

# HTTP listen address (default: 127.0.0.1:8080)
OPENTRACE_LISTEN_ADDR=127.0.0.1:8080

# Enable dev mode: live template reload, /api/dev/hash endpoint (default: false)
# OPENTRACE_DEV=true

# ─── Guardrails ─────────────────────────────────────────────────────
# Max rows returned from connector queries (default: 500)
OPENTRACE_MAX_QUERY_ROWS=500

# Postgres statement timeout in milliseconds (default: 5000)
OPENTRACE_STATEMENT_TIMEOUT_MS=5000

# ─── Resource Profile ───────────────────────────────────────────────
# One coherent memory/concurrency budget, so the caches below cannot each
# assume they own most of the box. `balanced` (default) suits a normal server;
# `tiny` targets a 1-vCPU / 256MB VM by pinning GOMAXPROCS=1, GOMEMLIMIT=160MB,
# 8MB column + 8MB SQLite caches, single-threaded search, and smaller seal row
# groups. Every individual knob below still overrides the profile.
# OPENTRACE_RESOURCE_PROFILE=balanced
#
# Profile overrides (each optional; unset means "use the profile's value"):
# OPENTRACE_GOMAXPROCS, OPENTRACE_MEMORY_LIMIT_MB, OPENTRACE_WAL_CACHE_MB,
# OPENTRACE_INDEX_CACHE_MB, OPENTRACE_SQLITE_CACHE_MB, OPENTRACE_SQLITE_MMAP_MB,
# OPENTRACE_SEARCH_CONCURRENCY, OPENTRACE_MAX_CONCURRENT_QUERIES,
# OPENTRACE_SEAL_CHUNK_ENTRIES, OPENTRACE_INGEST_RATE_LIMIT_PER_MINUTE,
# OPENTRACE_INGEST_INFLIGHT_MB, OPENTRACE_POSTPROCESS_WORKERS,
# OPENTRACE_POSTPROCESS_QUEUE, OPENTRACE_ACCESS_LOG, OPENTRACE_WAL_COMPRESS_BODY

# Memory budget for the log store's decoded-column cache, in MB (default: 64).
# Sealed log chunks never change, so decoded columns are reused across queries
# instead of being decompressed again. Lower it on a small box; 0 disables the
# cache and every query decodes from scratch.
# OPENTRACE_COLUMN_CACHE_MB=64

# Max parsed entries cached for the current (unsealed) hour (default: 200000).
# Dropped when the hour seals. Lower it on a small box; 0 disables the cache and
# every query touching the live hour re-parses its WAL from disk.
# OPENTRACE_WAL_CACHE_ENTRIES=200000

# ─── Security ───────────────────────────────────────────────────────
# API key for log ingestion (POST /api/logs requires Authorization: Bearer <key>)
# If unset, also checked in DB via admin settings page.
# OPENTRACE_API_KEY=

# Comma-separated list of trusted reverse proxy IPs. When set,
# X-Forwarded-For is used for rate limiting. When empty (default),
# only the direct connection IP is used.
# OPENTRACE_TRUSTED_PROXIES=

# CORS allowed origins for browser JS error tracking (comma-separated).
# Use "*" to allow all origins (dev only). Leave empty to disable CORS.
# OPENTRACE_CORS_ORIGINS=https://myapp.com,https://staging.myapp.com

# ─── MCP Server ─────────────────────────────────────────────────────
# Token for MCP SSE transport authentication (Bearer token)
# OPENTRACE_MCP_TOKEN=

# Custom MCP server name (shown in client UIs)
# OPENTRACE_MCP_NAME=

# ─── Data Retention ─────────────────────────────────────────────────
# Override metric retention independently of global setting (days, 0 = use global)
# OPENTRACE_METRIC_RETENTION_DAYS=30

# ─── Alerts ─────────────────────────────────────────────────────────
# Generic JSON webhook receiving watch-rule and health-check alerts.
# Slack and Telegram are configured at runtime instead — see docs/notifications.md
# OPENTRACE_ALERT_WEBHOOK_URL=https://example.com/hooks/opentrace

# ─── Liveness (dead man's switch) ───────────────────────────────────
# External URL pinged once a minute to prove this process is alive. Point it at
# a free monitor (healthchecks.io, cronitor); it alarms when the pings stop.
#
# Without this, an OpenTrace that has died is indistinguishable from an
# OpenTrace with nothing to report. It watches your app's heartbeat; nothing
# watches its own.
# OPENTRACE_HEARTBEAT_URL=https://hc-ping.com/your-uuid

# ─── On-Call Agent ──────────────────────────────────────────────────
# Runs your own coding-agent CLI against an alert while you are asleep and
# delivers a diagnosis instead of a raw threshold. OFF BY DEFAULT.
#
# Turning this on sends alert data (including log excerpts) to whichever model
# provider your configured command talks to. That is a real change to "no
# external calls" — it is opt-in on purpose.
#
# Auth on a Claude Pro/Max subscription, no API bill:
#   1. On your laptop:  claude setup-token
#   2. In the systemd unit:  Environment=CLAUDE_CODE_OAUTH_TOKEN=...
#      (or EnvironmentFile= at mode 0600 — that token is your Claude account)
# OPENTRACE_ONCALL_ENABLED=true
#
# The command to run. Prompt and alert arrive on stdin; stdout is the
# diagnosis, so any CLI works. Default: claude -p --permission-mode dontAsk
# Without a permission mode the CLI blocks forever on the first tool approval.
# Do NOT add --bare: it reads ANTHROPIC_API_KEY only and ignores OAuth.
# OPENTRACE_ONCALL_CMD=claude -p --permission-mode dontAsk --mcp-config /etc/opentrace/mcp.json
#
# Spend and noise caps. There is no --max-turns in current Claude Code builds,
# so these are what bound a runaway agent.
# OPENTRACE_ONCALL_MAX_PER_DAY=10
# OPENTRACE_ONCALL_TIMEOUT=5m
# OPENTRACE_ONCALL_COOLDOWN=1h
#
# Working directory for the command — where its .mcp.json lives.
# OPENTRACE_ONCALL_WORKSPACE=/etc/opentrace
#
# File each diagnosis as a GitHub issue (owner/name). Requires `gh` on PATH,
# authenticated with issue scope. One issue per error fingerprint per
# environment, forever: recurrences reopen and comment rather than filing again.
# Issues only — never pull requests.
# OPENTRACE_ONCALL_GITHUB_REPO=you/your-app

# ─── Proactive Reporting ────────────────────────────────────────────
# Push the catch-up brief to your chat channels on a timer, so the night you
# did not open an agent is not a night you missed. Default 24h; `off` disables.
# Deploy check-ins (1h and 24h after each new commit) are always on and use the
# same channels.
# OPENTRACE_CATCHUP_PUSH_INTERVAL=24h
#
# The money path. Comma-separated substrings matched against routes, services
# and error text; anything matching sorts first in the brief and in the error
# impact ranking. A watch created with urgency=critical counts too.
# OPENTRACE_CRITICAL_PATHS=/checkout,/billing,/subscribe

# ─── Managed Mode (cloud platform sets these) ──────────────────────
# OPENTRACE_MANAGED=true
# OPENTRACE_TRUST_PROXY_AUTH=true
# OPENTRACE_MAX_DB_SIZE=500000000
